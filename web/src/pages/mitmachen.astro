---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import CtaBand from "../components/CtaBand.astro";
import ContentBand from "../components/ContentBand.astro";

const ways = [
  {
    eyebrow: "Taubenhaus & Volieren",
    title: "Vor Ort versorgen",
    text: "Futter und Wasser kontrollieren, reinigen, Nester prüfen und Eier tauschen – mit guter Einführung und im Team.",
    href: "#ehrenamt",
    icon: "home" as const
  },
  {
    eyebrow: "Fundtierhilfe",
    title: "Sichern, telefonieren, fahren",
    text: "Fundmeldungen weitergeben, Menschen am Telefon helfen oder eine Fahrt zu einer Praxis übernehmen.",
    href: "#ehrenamt",
    icon: "phone" as const
  },
  {
    eyebrow: "Aufklärung & Material",
    title: "Wissen weitergeben",
    text: "Handtücher, Kartons, Transportboxen, Futter oder Reinigungsmaterial helfen direkt im Alltag.",
    href: "/spenden#sachspenden",
    icon: "box" as const
  },
  {
    eyebrow: "Verein stärken",
    title: "Mitglied werden",
    text: "Mit einer Mitgliedschaft gibst du der Arbeit in Bernau eine verlässliche Basis.",
    href: "/verein#mitglied-werden",
    icon: "heart" as const
  }
];
---

<BaseLayout
  title="Mitmachen"
  description="Ehrenamtlich bei Stadttaubenhilfe Bernau helfen: Taubenhaus, Notfälle, Fahrten, Material, Aufklärung und Spenden."
  theme="participate"
>
  <PageHero
    eyebrow="Mitmachen"
    title="Deine Zeit kann für Tauben ein sicherer Ort sein."
    text="Du musst keine Taubenexpertin und kein Taubenexperte sein. Was zählt, ist eine Aufgabe, die zu deinem Alltag passt und auf die wir uns verlassen können. Wir zeigen dir alles in Ruhe."
    primaryHref="#ehrenamt"
    primaryLabel="Möglichkeiten ansehen"
    secondaryHref="/spenden"
    secondaryLabel="Spenden"
    visualLabel="Infostand der Stadttaubenhilfe Bernau"
    imageSrc="/images/infostand-verein.jpg"
    imageAlt="Infostand der Stadttaubenhilfe Bernau mit Vereinsmaterial"
    imagePosition="center 42%"
    mobileImagePosition="center 34%"
    mobileFrameRatio="4 / 3"
  />

  <ContentBand
    tone="navy"
    eyebrow="Du entscheidest, was passt"
    title="Hilfe hat viele Formen."
    text="Ob vor Ort, unterwegs oder im Hintergrund: Wir finden gemeinsam eine Aufgabe, die zu deinem Alltag passt und auf die wir uns verlassen können."
    imageSrc="/images/gallery/taubenhaus-kontrolle-01.jpg"
    imageAlt="Ehrenamtliche beim Kontrollgang im Taubenhaus"
    imagePosition="center 50%"
    features={[
      { icon: "home", title: "Vor Ort", text: "Taubenhaus, Voliere und Infostand." },
      { icon: "phone", title: "Unterwegs", text: "Fundmeldungen und Fahrten begleiten." },
      { icon: "hands", title: "Im Hintergrund", text: "Material, Planung und Social Media." }
    ]}
  />

  <section class="section section-tight" id="ehrenamt">
    <div class="container">
      <SectionHeader
        eyebrow="So kannst du helfen"
        title="Eine Aufgabe, die zu deinem Alltag passt."
        text="Im Taubenhaus, bei Fundtieren, für die Öffentlichkeit oder im Hintergrund: Wir besprechen den Einsatz persönlich und in deinem Tempo."
      />
      <div class="grid grid-4 topic-grid">
        {ways.map((way) => (
          <Card href={way.href} eyebrow={way.eyebrow} title={way.title} icon={way.icon} tone="blue">
            <p>{way.text}</p>
            <span class="card-more">Mehr dazu →</span>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container volunteer-note">
      <div>
        <span class="eyebrow">Realistisch helfen</span>
        <h2>Eine feste Stunde im Monat zählt.</h2>
      </div>
      <p>Nicht jede Aufgabe findet direkt am Tier statt. Manche Menschen helfen mit Fahrten, Wäsche, Kartons, Futter, Social Media oder Infoständen. Einmalig, monatlich oder regelmäßig: Gemeinsam finden wir einen guten Einstieg.</p>
      <a class="button button-primary" href="/kontakt">Kontakt aufnehmen</a>
    </div>
  </section>

  <CtaBand
    eyebrow="Kontakt"
    title="Schreib uns, was für dich realistisch ist."
    text="Einmalig, monatlich oder regelmäßig: Gemeinsam finden wir eine Aufgabe, die gerade gebraucht wird."
    href="/kontakt"
    label="Mitmachen anfragen"
  />
</BaseLayout>
