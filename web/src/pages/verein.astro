---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ContentBand from "../components/ContentBand.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import CtaBand from "../components/CtaBand.astro";

const links = [
  { eyebrow: "Unser Verein", title: "Wer wir sind", text: "Ehrenamtlich, lokal und nah an den Tieren – für weniger Leid und bessere Lösungen in Bernau.", href: "#verein", icon: "together" as const },
  { eyebrow: "Vorstand", title: "Verantwortung & Transparenz", text: "Der Vorstand trägt Verantwortung dafür, dass die Vereinsarbeit verlässlich und im Sinne der Tiere organisiert wird.", href: "#vorstand", icon: "book" as const },
  { eyebrow: "Mitglied werden", title: "Den Verein stärken", text: "Mitgliedschaft gibt unserer Arbeit eine dauerhaft verlässliche Basis.", href: "#mitglied-werden", icon: "heart" as const },
  { eyebrow: "Ehrenamt", title: "Direkt mithelfen", text: "Eine feste Stunde, eine Fahrt oder eine Aufgabe im Hintergrund kann viel bewirken.", href: "/mitmachen#ehrenamt", icon: "hands" as const }
];

const board = [
  { role: "Vorsitzende", name: "Susanne Hegewald-Gedicke" },
  { role: "Stellvertretende Vorsitzende", name: "Xenia Laws" },
  { role: "Schatzmeister", name: "Paul Bratfisch" }
];

const heroImage = "/images/gallery/vereinsarbeit-mensch-tauben-02.jpg";
const teamImage = "/images/gallery/vereinsarbeit-sicherung-02.jpg";
---

<BaseLayout title="Unser Verein" description="Stadttaubenhilfe Bernau: ehrenamtlich, lokal und nah an den Tieren." image={heroImage} theme="participate">
  <PageHero eyebrow="Unser Verein" title="Wir übernehmen Verantwortung, wo andere wegsehen." text="Die Stadttaubenhilfe Bernau e. V. ist ein ehrenamtlicher Verein für praktischen, sachkundigen und lösungsorientierten Stadttaubenschutz in Bernau und Umgebung. Wir helfen einzelnen Tieren – und arbeiten zugleich daran, dass weniger Tiere überhaupt in Not geraten." primaryHref="/mitmachen" primaryLabel="Mitmachen" secondaryHref="#vorstand" secondaryLabel="Unser Vorstand" visualLabel="Ehrenamtliche mit betreuten Tauben" imageSrc={heroImage} imageAlt="Ehrenamtliche hält zwei betreute Tauben im Garten" imagePosition="center 42%" mobileImagePosition="center 38%" />

  <ContentBand id="verein" tone="navy" eyebrow="Wofür wir da sind" title="Wir helfen einzelnen Tieren – und verändern die Bedingungen, die sie in Not bringen." text="Praktische Hilfe, betreute Standorte und Wissen gehören zusammen. So bleibt Stadttaubenschutz in Bernau nicht bei einzelnen Rettungen stehen." features={[
    { icon: "care", title: "Tierschutz vor Ort", text: "Wir versorgen Fundtiere, betreuen den Standort und schaffen Schutz für Tiere mit besonderem Bedarf." },
    { icon: "home", title: "Nachhaltige Lösungen", text: "Wir setzen auf betreute Standorte, Eiertausch, Reinigung und Kooperation statt auf endlose Verdrängung." },
    { icon: "book", title: "Wissen teilen", text: "Wir erklären Zusammenhänge, beraten bei Konflikten und bringen Stadttauben als Stadtthema ins Gespräch." }
  ]} />

  <section id="vorstand" class="section section-tight team-section">
    <div class="container">
      <SectionHeader eyebrow="Vorstand" title="Verantwortung hat bei uns Namen." text="Der Vorstand trägt Verantwortung dafür, dass die Vereinsarbeit verlässlich, transparent und im Sinne der Tiere organisiert wird." />
      <div class="team-board" aria-label="Vorstand der Stadttaubenhilfe Bernau">
        {board.map((member) => (
          <article>
            <span>{member.role}</span>
            <h3>{member.name}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="mitglied-werden" class="section section-tight member-section">
    <div class="container member-layout">
      <figure class="member-image">
        <img src={teamImage} alt="Ehrenamtliche sichert eine Taube bei einem Einsatz in einem Gebäude" loading="lazy" decoding="async" />
      </figure>
      <div class="member-copy">
        <p class="eyebrow">Unser Team</p>
        <h2>Gemeinsam für die Tiere.</h2>
        <p>Mit einer Mitgliedschaft machst du Hilfe planbar. Sie stärkt den Verein, gibt unserer Stimme Gewicht und hilft, Versorgung, Eiertausch, Notfallhilfe und Bildungsarbeit dauerhaft zu tragen.</p>
        <a class="button button-primary" href="/kontakt">Mitgliedschaft anfragen</a>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <SectionHeader eyebrow="Vier Wege zum Verein" title="Alles Wichtige, direkt erreichbar." text="Die Übersicht hält den Einstieg kurz; jedes Thema ist als eigener Bereich erreichbar." />
      <nav class="grid grid-4 topic-grid" aria-label="Informationen zum Verein">
        {links.map((link) => <Card href={link.href} eyebrow={link.eyebrow} title={link.title} icon={link.icon} tone="blue"><p>{link.text}</p><span class="card-more">Mehr erfahren →</span></Card>)}
      </nav>
    </div>
  </section>

  <CtaBand eyebrow="Gemeinsam für Bernau" title="Du möchtest den Verein kennenlernen?" text="Schreib uns direkt – bei Mitgliedschaft, Ehrenamt, Kooperationen oder einer konkreten Frage." href="/kontakt" label="Kontakt aufnehmen" />
</BaseLayout>

<style>
  .team-section { background: #eaf3fc; }

  .team-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid #c9dced;
    background: #fff;
  }

  .team-board article { min-width: 0; padding: clamp(24px, 3vw, 38px); }
  .team-board article + article { border-left: 1px solid #c9dced; }
  .team-board span { display: block; margin-bottom: 18px; color: #32638d; font-size: .82rem; font-weight: 700; text-transform: uppercase; }
  .team-board h3 { margin: 0; color: #123757; font-size: clamp(1.25rem, 2vw, 1.8rem); line-height: 1.05; }

  .member-section { background: #fff; }
  .member-layout { display: grid; grid-template-columns: minmax(280px, .88fr) minmax(0, 1.12fr); gap: clamp(30px, 6vw, 82px); align-items: center; }
  .member-image { min-height: 420px; margin: 0; overflow: hidden; background: #0d2942; }
  .member-image img { width: 100%; height: 100%; min-height: inherit; object-fit: cover; object-position: center 42%; }
  .member-copy { max-width: 620px; }
  .member-copy h2 { margin: 0; color: #123757; font-size: clamp(2.15rem, 4vw, 4rem); line-height: .98; letter-spacing: -.035em; }
  .member-copy > p:not(.eyebrow) { margin: 22px 0 0; color: #123757; font-size: 1.08rem; line-height: 1.55; }
  .member-copy .button { margin-top: 28px; }

  @media (max-width: 800px) {
    .team-board { grid-template-columns: 1fr; }
    .team-board article + article { border-top: 1px solid #c9dced; border-left: 0; }
    .member-layout { grid-template-columns: 1fr; gap: 30px; }
    .member-image { min-height: 0; aspect-ratio: 4 / 3; }
  }
</style>
