---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import MetricStrip from "../components/MetricStrip.astro";
import CtaBand from "../components/CtaBand.astro";
import ContentBand from "../components/ContentBand.astro";
import LineIcon from "../components/LineIcon.astro";
import projectsContent from "../data/projects.json";

const { hero, intro, items } = projectsContent;

const verifiedProjectFigure = [
  { value: "700+", label: "Eier gegen Attrappen getauscht · 2023" }
];

const projectIcons = ["home", "care", "alert", "hands", "book"] as const;
const projectHref = (id: string) => id === "oeffentlichkeit" ? "/bildung" : `/projekte/${id}`;
---

<BaseLayout
  title="Was wir tun"
  description="Taubenhaus, Notfallhilfe, Volieren, Beratung und Aufklärung der Stadttaubenhilfe Bernau."
  image={hero.imageSrc}
  theme="projects"
>
  <PageHero {...hero} />

  <ContentBand
    tone="navy"
    eyebrow="Unser Einsatz in Bernau"
    title="Versorgung, Eiertausch, Fundtierhilfe, Beratung und Aufklärung gehören zusammen."
    text="Wir arbeiten nicht mit einer einzelnen Maßnahme. Erst feste Orte, tägliche Pflege, Eiertausch, Notfallhilfe und gute Gespräche machen Stadttaubenhilfe wirksam."
    imageSrc="/images/projects/startbild-wissen-taubenhaus.jpg"
    imageAlt="Blick über den Treppenaufgang in das betreute Taubenhaus mit vielen Tauben"
    imagePosition="center 50%"
    features={[
      { icon: "home", title: "Versorgung", text: "Futter, Wasser und Nistplätze am festen Standort." },
      { icon: "care", title: "Betreuung", text: "Eiertausch, Reinigung und Blick auf jedes Tier." },
      { icon: "book", title: "Aufklärung", text: "Wissen, das Vorurteile durch Lösungen ersetzt." }
    ]}
  />

  <section class="section section-tight" aria-labelledby="projekte-ueberblick">
    <div class="container">
      <SectionHeader
        eyebrow={intro.eyebrow}
        title={intro.title}
        text="Wähle ein Thema und lies weiter – die Übersicht bleibt bewusst kurz, die Details haben ihre eigene Seite."
      />
      <nav class="project-toc" id="projekte-ueberblick" aria-label="Bereiche unserer Arbeit">
        {items.map((item, index) => (
          <a class:list={["project-toc-card", `project-toc-card-${index % 5}`]} href={projectHref(item.id)}>
            <LineIcon name={projectIcons[index]} />
            <span>{item.label}</span>
            <strong>{item.title}</strong>
            <small>Mehr erfahren →</small>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container flagship-project">
      <div>
        <span class="eyebrow">Bernau konkret</span>
        <h2>Vom Konfliktort zur Lösung im Fahrradparkhaus.</h2>
        <div class="flagship-copy">
          <p>Wo früher Tauben zwischen Fahrrädern und Durchgangsverkehr saßen, entsteht ein betreuter Ort. Futter, Wasser und Nistmöglichkeiten geben dem Schwarm einen festen Platz. Durch regelmäßige Nestkontrolle und Eiertausch wird Nachwuchs tierschutzgerecht begrenzt; Reinigung und Beobachtung verbessern die Situation für alle, die das Fahrradparkhaus nutzen.</p>
          <a class="text-link text-link-light" href="/projekte/taubenhaus">Das Taubenhaus kennenlernen →</a>
        </div>
      </div>
      <MetricStrip items={verifiedProjectFigure} />
    </div>
  </section>

  <CtaBand
    eyebrow="Unterstützung"
    title="Diese Arbeit braucht Unterstützung."
    text="Futter, Reinigung, Fahrten, tierärztliche Kosten und Zeit machen diese Arbeit möglich."
    href="/spenden"
    label="Spendenmöglichkeit anfragen"
  />
</BaseLayout>
