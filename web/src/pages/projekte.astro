---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import MetricStrip from "../components/MetricStrip.astro";
import CtaBand from "../components/CtaBand.astro";
import ContentBand from "../components/ContentBand.astro";
import LineIcon from "../components/LineIcon.astro";
import projectsContent from "../data/projects.json";

const { hero, intro, items } = projectsContent;

const projectNumbers = [
  { value: "700+", label: "Eier pro Jahr gegen Attrappen getauscht" },
  { value: "170+", label: "Tauben am betreuten Standort" },
  { value: "3×", label: "Nestkontrolle und Eiertausch pro Woche" },
  { value: "4–5 h", label: "Reinigung pro Woche im Taubenhaus" }
];

const projectIcons = ["home", "care", "alert", "hands", "book"] as const;
---

<BaseLayout
  title="Was wir tun"
  description="Taubenhaus, Notfallhilfe, Volieren, Beratung und Aufklärung der Stadttaubenhilfe Bernau."
  image={hero.imageSrc}
  theme="projects"
>
  <PageHero {...hero} />

  <ContentBand
    tone="navy"
    eyebrow="Unser Einsatz in Bernau"
    title="Versorgung, Betreuung, Aufklärung und Miteinander."
    text="Wir arbeiten nicht mit einer einzelnen Maßnahme. Erst feste Orte, tägliche Pflege, Eiertausch, Notfallhilfe und gute Gespräche machen Stadttaubenhilfe wirksam."
    imageSrc="/images/gallery/taubenhaus-fahrradparkhaus-01.jpg"
    imageAlt="Blick in den betreuten Taubenhaus-Bereich im Fahrradparkhaus Bernau"
    imagePosition="center 42%"
    features={[
      { icon: "home", title: "Versorgung", text: "Futter, Wasser und Nistplätze am festen Standort." },
      { icon: "care", title: "Betreuung", text: "Eiertausch, Reinigung und Blick auf jedes Tier." },
      { icon: "book", title: "Aufklärung", text: "Wissen, das Vorurteile durch Lösungen ersetzt." }
    ]}
  />

  <section class="section section-tight" aria-labelledby="projekte-ueberblick">
    <div class="container">
      <SectionHeader
        eyebrow={intro.eyebrow}
        title={intro.title}
        text="Wähle ein Thema und lies weiter – die Übersicht bleibt bewusst kurz, die Details haben ihre eigene Seite."
      />
      <nav class="project-toc" id="projekte-ueberblick" aria-label="Bereiche unserer Arbeit">
        {items.map((item, index) => (
          <a class:list={["project-toc-card", `project-toc-card-${index % 5}`]} href={`/projekte/${item.id}`}>
            <LineIcon name={projectIcons[index]} />
            <span>{item.label}</span>
            <strong>{item.title}</strong>
            <small>Mehr erfahren →</small>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container flagship-project">
      <div>
        <span class="eyebrow">Vorzeigeprojekt in Barnim und Brandenburg</span>
        <h2>Vom Fahrradparkhaus zum betreuten Taubenhaus.</h2>
        <div class="flagship-copy">
          <p>
            Im Fahrradparkhaus entsteht aus einem konkreten Konflikt ein betreuter Ort:
            mit Nistflächen, Futter, Wasser, Reinigung und Eiertausch. So bleiben die
            Tauben nicht auf Fahrradständern und die Fläche wird für alle besser nutzbar.
          </p>
          <a class="text-link text-link-light" href="/projekte/taubenhaus">Das Taubenhaus kennenlernen →</a>
        </div>
      </div>
      <MetricStrip items={projectNumbers} />
    </div>
  </section>

  <CtaBand
    eyebrow="Unterstützung"
    title="Diese Arbeit braucht Unterstützung."
    text="Futter, Reinigung, Fahrten, tierärztliche Kosten und Zeit fallen jede Woche an. Wer helfen möchte, kann spenden, Material geben oder einzelne Aufgaben übernehmen."
    href="/mitmachen"
    label="So kannst du helfen"
  />
</BaseLayout>
