---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import ContentBand from "../components/ContentBand.astro";
import CtaBand from "../components/CtaBand.astro";
import wissenContent from "../data/wissen.json";

const { hero } = wissenContent;

const facts = [
  { title: "Sie ziehen nicht einfach in den Wald.", text: "Die Stadt bietet Felsersatz, vertraute Brutplätze und den Schwarm. Im Wald fehlen diese Strukturen.", icon: "home" as const },
  { title: "Sie sind von Menschen abhängig gemacht worden.", text: "Über Jahrhunderte wurden Tauben gezüchtet, gehalten und ausgesetzt oder gingen verloren. Stadttauben tragen diese Geschichte bis heute.", icon: "feather" as const },
  { title: "Verdrängung löst das Problem nicht.", text: "Werden Tiere an einem Ort vertrieben, suchen sie den nächsten Nistplatz. Ein betreuter Standort schafft dagegen eine dauerhafte, kontrollierbare Lösung.", icon: "alert" as const },
  { title: "Betreuung hilft Menschen und Tieren.", text: "Futter, Wasser, Eiertausch, Reinigung und Beobachtung an einem festen Ort begrenzen Nachwuchs und reduzieren Verschmutzung sowie Konflikte.", icon: "care" as const }
];

const topics = [
  {
    eyebrow: "Herkunft",
    title: "Die Stadt ist ihr Ersatzfelsen.",
    text: "Warum Stadttauben Gebäude, Nischen und Parkhäuser nutzen – und nicht einfach in den Wald ziehen.",
    href: "/wissen/ersatzfelsen",
    icon: "home" as const
  },
  {
    eyebrow: "Einordnen",
    title: "Taube gleich Taube?",
    text: "Stadt-, Wild-, Brief- und Rassetauben brauchen je nach Situation unterschiedliche Hilfe.",
    href: "/taube-gleich-taube",
    icon: "feather" as const
  },
  {
    eyebrow: "Vorurteile",
    title: "Mythen durch Fakten ersetzen.",
    text: "Warum Vergrämung nicht reicht und betreute Taubenhäuser eine nachhaltige Lösung sind.",
    href: "/wissen/mythen",
    icon: "book" as const
  },
  {
    eyebrow: "Alltag",
    title: "Was Stadttauben wirklich hilft.",
    text: "Futter, Wasser, Nistplätze, Eiertausch und Hilfe bei Fundtieren – praktisch erklärt.",
    href: "/wissen/versorgung",
    icon: "care" as const
  }
];
---

<BaseLayout
  title="Taubenwissen"
  description="Fakten zu Stadttauben, Taubenhäusern, Hygiene und tierschutzgerechtem Eiermanagement in Bernau."
  image={hero.imageSrc}
  theme="knowledge"
>
  <PageHero {...hero} />

  <ContentBand
    tone="blue"
    eyebrow="Stadttauben verstehen"
    title="Wissen schafft bessere Entscheidungen."
    text="Stadttauben sind Nachkommen von Haus- und Brieftauben. Wer ihre Herkunft und ihr Verhalten kennt, kann Hilfe und Konflikte besser einordnen."
    imageSrc="/images/projects/startbild-wissen-taubenhaus.jpg"
    imageAlt="Stadttauben am betreuten Standort in Bernau"
    imagePosition="center 38%"
    features={[
      { icon: "home", title: "Keine Wildvögel", text: "Stadttauben sind Nachkommen domestizierter Tiere." },
      { icon: "feather", title: "Ersatzfelsen", text: "Gebäude und Parkhäuser ersetzen den natürlichen Felsraum." },
      { icon: "care", title: "Betreuung wirkt", text: "Taubenhäuser verbinden Versorgung, Eiertausch und Reinigung." }
    ]}
  />

  <section class="section section-tight" id="herkunft">
    <div class="container">
      <SectionHeader eyebrow="Vier wichtige Fakten" title="Die Stadt ist ihr Ersatzfelsen." text="Stadttauben sind keine Wildvögel, die sich die Stadt ausgesucht haben. Ihre wilden Vorfahren brüteten an Felsen – deshalb suchen sie heute Mauernischen, Brücken, Dachböden und Parkhäuser auf." />
      <div class="grid grid-4 topic-grid">
        {facts.map((fact) => <Card title={fact.title} icon={fact.icon} tone="blue"><p>{fact.text}</p></Card>)}
      </div>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="wissen-themen">
    <div class="container">
      <SectionHeader
        eyebrow="Themen im Überblick"
        title="Was du über Stadttauben wissen solltest."
        text="Die vier Themen führen direkt zu der Einordnung, die du gerade brauchst."
      />
      <nav class="grid grid-4 topic-grid" id="wissen-themen" aria-label="Wissensthemen">
        {topics.map((topic) => (
          <Card href={topic.href} eyebrow={topic.eyebrow} title={topic.title} icon={topic.icon} tone="blue">
            <p>{topic.text}</p>
            <span class="card-more">Weiterlesen →</span>
          </Card>
        ))}
      </nav>
    </div>
  </section>

  <CtaBand
    eyebrow="Bildung und Downloads"
    title="Material zum Lernen, Weitergeben und Handeln."
    text="Faktenblatt, Notfallkarte, Arbeitsblätter und Informationen für Gebäude findest du gesammelt im Download-Bereich."
    href="/materialien"
    label="Materialien ansehen"
  />

  <CtaBand
    eyebrow="Unsicher bei einem Fundtier?"
    title="Bei einer verletzten Taube zählt schnelle, ruhige Hilfe."
    text="Wenn eine Taube nicht wegfliegt, blutet oder sichtbar geschwächt ist, bitte sichern und melden – nicht erst weiter nachlesen."
    href="/fundtiere"
    label="Erste Hilfe ansehen"
  />
</BaseLayout>
