---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import ContentBand from "../components/ContentBand.astro";
import CtaBand from "../components/CtaBand.astro";
import wissenContent from "../data/wissen.json";

const { hero } = wissenContent;

const topics = [
  {
    eyebrow: "Herkunft",
    title: "Die Stadt ist ihr Ersatzfelsen.",
    text: "Warum Stadttauben Gebäude, Nischen und Parkhäuser nutzen – und nicht einfach in den Wald ziehen.",
    href: "/wissen/ersatzfelsen",
    icon: "home" as const
  },
  {
    eyebrow: "Einordnen",
    title: "Taube gleich Taube?",
    text: "Stadt-, Wild-, Brief- und Rassetauben brauchen je nach Situation unterschiedliche Hilfe.",
    href: "/taube-gleich-taube",
    icon: "feather" as const
  },
  {
    eyebrow: "Vorurteile",
    title: "Mythen durch Fakten ersetzen.",
    text: "Warum Vergrämung nicht reicht und betreute Taubenhäuser eine echte Lösung sind.",
    href: "/wissen/mythen",
    icon: "book" as const
  },
  {
    eyebrow: "Alltag",
    title: "Was Stadttauben wirklich hilft.",
    text: "Futter, Wasser, Nistplätze, Eiertausch und Hilfe bei Fundtieren – praktisch erklärt.",
    href: "/wissen/versorgung",
    icon: "care" as const
  }
];
---

<BaseLayout
  title="Taubenwissen"
  description="Fakten zu Stadttauben, Taubenhäusern, Hygiene und tierschutzgerechtem Eiermanagement in Bernau."
  image={hero.imageSrc}
  theme="knowledge"
>
  <PageHero {...hero} />

  <ContentBand
    tone="blue"
    eyebrow="Stadttauben verstehen"
    title="Wissen schafft bessere Entscheidungen."
    text="Stadttauben sind keine Wildvögel, die sich ihre Stadt ausgesucht haben. Wer ihre Herkunft und ihr Verhalten kennt, kann Hilfe und Konflikte besser einordnen."
    imageSrc="/images/projects/startbild-wissen-taubenhaus.jpg"
    imageAlt="Stadttauben am betreuten Standort in Bernau"
    imagePosition="center 38%"
    features={[
      { icon: "home", title: "Ersatzfelsen", text: "Mauern, Dächer und Parkhäuser ersetzen den natürlichen Felsraum." },
      { icon: "feather", title: "Haustier-Nachkommen", text: "Stadttauben stammen von gezüchteten Haus-, Brief- und Rassetauben ab." },
      { icon: "care", title: "Betreuung wirkt", text: "Taubenhäuser verbinden Versorgung, Eiertausch und Reinigung." }
    ]}
  />

  <section class="section section-tight">
    <div class="container city-rock" id="herkunft">
      <div>
        <span class="eyebrow">Eine kurze Einordnung</span>
        <h2>Die Stadt ist ihr Ersatzfelsen.</h2>
      </div>
      <div class="city-rock-copy">
        <p>Felsentauben brüten in Nischen und Höhlen. Stadttauben zeigen dieses Verhalten noch heute: Häuserwände, Balkone, Brücken, Parkhäuser und Dachböden kommen einem Felsen am nächsten.</p>
        <p>Das erklärt, warum sie nicht einfach „in den Wald“ ziehen – dort fehlen passende Brutplätze und die vertrauten Strukturen.</p>
      </div>
    </div>
  </section>

  <section class="section section-tight" aria-labelledby="wissen-themen">
    <div class="container">
      <SectionHeader
        eyebrow="Themen im Überblick"
        title="Wähle die Frage, die dich gerade beschäftigt."
        text="Statt einer sehr langen Wissensseite führen die vier Themen direkt zu der Erklärung, die du brauchst."
      />
      <nav class="grid grid-4 topic-grid" id="wissen-themen" aria-label="Wissensthemen">
        {topics.map((topic) => (
          <Card href={topic.href} eyebrow={topic.eyebrow} title={topic.title} icon={topic.icon} tone="blue">
            <p>{topic.text}</p>
            <span class="card-more">Weiterlesen →</span>
          </Card>
        ))}
      </nav>
    </div>
  </section>

  <CtaBand
    eyebrow="Unsicher bei einem Fundtier?"
    title="Bei einer verletzten Taube zählt schnelle, ruhige Hilfe."
    text="Wenn eine Taube nicht wegfliegt, blutet oder sichtbar geschwächt ist, bitte sichern und melden – nicht erst weiter nachlesen."
    href="/fundtiere"
    label="Erste Hilfe ansehen"
  />
</BaseLayout>
