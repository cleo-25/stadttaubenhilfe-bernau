---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import CtaBand from "../components/CtaBand.astro";
import ContentBand from "../components/ContentBand.astro";
import navigationPages from "../data/navigation-pages.json";

type ChildLink = {
  label: string;
  href: string;
};

type ContentSection = {
  title: string;
  text: string;
};

type NavigationPage = {
  slug: string;
  title: string;
  eyebrow: string;
  description: string;
  text: string;
  image: string;
  imageAlt: string;
  children?: ChildLink[];
  sections?: ContentSection[];
};

export function getStaticPaths() {
  // The former template routes were intentionally retired. All maintained
  // content now lives on the focused overview pages and project detail routes.
  return [];
}

const { page } = Astro.props as { page: NavigationPage };
const childPages = page.children ?? [];
const pageTheme = page.slug.startsWith("taube-gefunden")
  ? "emergency"
  : page.slug.startsWith("verein-unterstuetzen") || page.slug.startsWith("verein")
    ? "participate"
    : page.slug.startsWith("arbeit") || page.slug === "stadttaubenmanagement"
      ? "projects"
      : "knowledge";
const bandFeatures = pageTheme === "emergency"
  ? [
      { icon: "box" as const, title: "Sichern", text: "Ruhe und eine sichere Unterbringung kommen zuerst." },
      { icon: "alert" as const, title: "Einschätzen", text: "Der Zustand entscheidet über den nächsten Schritt." },
      { icon: "phone" as const, title: "Melden", text: "Mit Foto, Fundort und Rückrufnummer Kontakt aufnehmen." }
    ]
  : pageTheme === "projects"
    ? [
        { icon: "home" as const, title: "Betreut", text: "Feste Orte machen Versorgung und Reinigung möglich." },
        { icon: "care" as const, title: "Praktisch", text: "Kontrolle, Pflege und Eiertausch gehören zusammen." },
        { icon: "hands" as const, title: "Gemeinsam", text: "Ehrenamt und lokale Zusammenarbeit machen Wirkung möglich." }
      ]
    : pageTheme === "participate"
      ? [
          { icon: "hands" as const, title: "Mithelfen", text: "Auch kleine, verlässliche Aufgaben zählen." },
          { icon: "book" as const, title: "Erklären", text: "Gute Information schafft Verständnis vor Ort." },
          { icon: "heart" as const, title: "Stärken", text: "Zeit, Material und Spenden halten Hilfe möglich." }
        ]
      : [
          { icon: "book" as const, title: "Verstehen", text: "Wissen schafft bessere Entscheidungen für Tauben." },
          { icon: "home" as const, title: "Einordnen", text: "Die Stadt ist für Stadttauben ihr Ersatzfelsen." },
          { icon: "feather" as const, title: "Handeln", text: "Eine ruhige Einschätzung hilft im richtigen Moment." }
        ];
const sections = page.sections?.length
  ? page.sections
  : [
      {
        title: "Was wir hier anbieten",
        text: "Die wichtigsten Informationen sind hier gebündelt. Bei einem konkreten Anliegen helfen wir persönlich weiter."
      },
      {
        title: "Direkt in Bernau",
        text: "Unsere Arbeit verbindet praktische Hilfe für Tiere mit verständlicher Beratung für Menschen vor Ort."
      }
    ];
---

<BaseLayout title={page.title} description={page.description} image={page.image} theme={pageTheme}>
  <PageHero
    eyebrow={page.eyebrow}
    title={page.title}
    text={page.text}
    primaryHref="/kontakt"
    primaryLabel="Kontakt aufnehmen"
    secondaryHref="/"
    secondaryLabel="Zur Startseite"
    visualLabel={page.title}
    imageSrc={page.image}
    imageAlt={page.imageAlt}
    imagePosition="center"
  />

  <ContentBand
    tone={pageTheme === "emergency" ? "coral" : pageTheme === "knowledge" ? "blue" : "navy"}
    eyebrow={page.eyebrow}
    title="Orientierung, die weiterhilft."
    text="Wir bündeln Wissen, praktische Schritte und die passenden Kontakte – klar strukturiert und direkt auf die Situation bezogen."
    features={bandFeatures}
  />

  {childPages.length > 0 && (
    <section class="section section-tight">
      <div class="container">
        <SectionHeader
          eyebrow="Unterseiten"
          title="Weitere Themen auf einen Blick."
          text="Wähle den Bereich, der zu deiner Frage passt."
        />
        <div class="template-page-grid topic-grid">
          {childPages.map((child, index) => (
            <Card href={child.href} title={child.label} tone="blue" icon={index % 4 === 0 ? "home" : index % 4 === 1 ? "book" : index % 4 === 2 ? "care" : "hands"}>
              <p>Direkt zum Thema →</p>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-tight">
    <div class="container template-page-content">
      <SectionHeader
        eyebrow="Das Wichtigste"
        title="Klar erklärt, direkt anwendbar."
        text="Die wichtigsten Punkte zu diesem Thema – kompakt zusammengefasst."
      />
      <div class="grid grid-2 topic-grid">
        {sections.map((section, index) => (
          <Card title={section.title} icon={index % 2 === 0 ? "book" : "home"} tone="blue">
            <p>{section.text}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Noch Fragen?"
    title="Wir helfen persönlich weiter."
    text="Wenn du etwas nicht findest oder eine konkrete Situation hast, schreib uns direkt."
    href="/kontakt"
    label="Kontakt aufnehmen"
  />
</BaseLayout>
