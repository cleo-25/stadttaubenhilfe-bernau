---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import CtaBand from "../components/CtaBand.astro";
import navigationPages from "../data/navigation-pages.json";

type ChildLink = {
  label: string;
  href: string;
};

type ContentSection = {
  title: string;
  text: string;
};

type NavigationPage = {
  slug: string;
  title: string;
  eyebrow: string;
  description: string;
  text: string;
  image: string;
  imageAlt: string;
  children?: ChildLink[];
  sections?: ContentSection[];
};

export function getStaticPaths() {
  return (navigationPages as NavigationPage[]).map((page) => ({
    params: { slug: page.slug },
    props: { page }
  }));
}

const { page } = Astro.props as { page: NavigationPage };
const childPages = page.children ?? [];
const sections = page.sections?.length
  ? page.sections
  : [
      {
        title: "Inhalt folgt",
        text: "Diese Seite ist als Vorlage angelegt. Texte, Bilder und Detailinhalte können später über das CMS gepflegt und nach dem finalen Design sauber eingetragen werden."
      },
      {
        title: "Design-Vorlage",
        text: "Layout, Navigation, Hero-Bild und Kartenstruktur sind vorbereitet. So bleibt die neue Seitenarchitektur stabil, während die Inhalte Schritt für Schritt wachsen."
      }
    ];
---

<BaseLayout title={page.title} description={page.description} image={page.image}>
  <PageHero
    eyebrow={page.eyebrow}
    title={page.title}
    text={page.text}
    primaryHref="/kontakt"
    primaryLabel="Kontakt aufnehmen"
    secondaryHref="/cms-preview/"
    secondaryLabel="Zur Startseite"
    visualLabel={page.title}
    imageSrc={page.image}
    imageAlt={page.imageAlt}
    imagePosition="center"
  />

  {childPages.length > 0 && (
    <section class="section section-tight">
      <div class="container">
        <SectionHeader
          eyebrow="Unterseiten"
          title="Alle Inhalte als eigene Seiten vorbereitet."
          text="Jeder Menü-Unterpunkt hat jetzt eine eigene URL und kann später separat über das CMS mit Inhalt, Bildern und SEO-Texten gepflegt werden."
        />
        <div class="template-page-grid">
          {childPages.map((child) => (
            <Card href={child.href} title={child.label} tone="blue">
              <p>Vorlage öffnen und später mit finalem Inhalt befüllen.</p>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section-tight">
    <div class="container template-page-content">
      <SectionHeader
        eyebrow="Vorlage"
        title="Bereit für Inhalt und Feinschliff."
        text="Diese Seite ist bewusst schlicht angelegt: genügend Struktur für Navigation, CMS und spätere Inhalte, ohne das finale Design jetzt festzunageln."
      />
      <div class="grid grid-2">
        {sections.map((section) => (
          <article class="soft-panel compact-panel">
            <h2>{section.title}</h2>
            <p>{section.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Nächster Schritt"
    title="Inhalte können später im CMS gepflegt werden."
    text="Die Seitenstruktur ist jetzt vorbereitet. Sobald das finale Design steht, können Texte, Bilder und Seitendetails gezielt ergänzt werden."
    href="/kontakt"
    label="Kontakt aufnehmen"
  />
</BaseLayout>
