---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { legalEntity } from "../data/legal";
---

<BaseLayout
  title="Impressum"
  description="Impressum der Stadttaubenhilfe Bernau b. Berlin e.V. mit Vereinsregister-, Kontakt- und Vorstandsangaben."
  theme="legal"
>
  <PageHero
    eyebrow="Rechtliches"
    title="Impressum"
    text="Die wichtigsten Angaben zur Stadttaubenhilfe Bernau b. Berlin e.V. und zur Verantwortlichkeit dieser Website."
    primaryHref="/kontakt"
    primaryLabel="Kontakt aufnehmen"
    visualLabel="Stadttaubenhilfe Bernau"
    imageSrc="/images/projects/startbild-galerie.jpg"
    imageAlt="Taubenschwarm am Taubenhaus in Bernau"
    imagePosition="center 44%"
    mobileImagePosition="center 32%"
    mobileFrameRatio="4 / 3"
  />

  <section class="section section-tight legal-page">
    <div class="container legal-grid">
      <article class="soft-panel legal-main">
        <span class="eyebrow">Anbieterkennzeichnung</span>
        <h2>Angaben nach § 5 DDG</h2>

        <dl class="legal-list">
          <div>
            <dt>Name</dt>
            <dd>{legalEntity.name}</dd>
          </div>
          <div>
            <dt>Sitz</dt>
            <dd>{legalEntity.locality}</dd>
          </div>
          <div>
            <dt>Ladungsfähige Anschrift</dt>
            <dd>
              {legalEntity.street}<br />
              {legalEntity.postalCode} {legalEntity.locality}
            </dd>
          </div>
          <div>
            <dt>Registereintrag</dt>
            <dd>
              Registergericht: {legalEntity.registryCourt}<br />
              Registernummer: {legalEntity.registryNumber}
            </dd>
          </div>
          <div>
            <dt>Vorstand gemäß § 26 BGB</dt>
            <dd>
              {legalEntity.board.map((member) => (
                <>{member.name} ({member.role})<br /></>
              ))}
              {legalEntity.representation}
            </dd>
          </div>
          <div>
            <dt>Kontakt</dt>
            <dd>
              <a href="tel:+491626435114">+49 162 6435114</a><br />
              <a href="mailto:kontakt@stadttaubenhilfe-bernau.de">kontakt@stadttaubenhilfe-bernau.de</a>
            </dd>
          </div>
        </dl>

      </article>

      <aside class="soft-panel legal-aside">
        <span class="eyebrow">Redaktion</span>
        <h2>Inhalte dieser Website</h2>
        <p>
          Verantwortlich für die Inhalte ist {legalEntity.name},
          soweit keine anderen Quellen genannt sind.
        </p>

        <h3>Externe Links</h3>
        <p>
          Links zu Facebook, Instagram oder anderen externen Seiten öffnen in einem
          neuen Tab. Für Inhalte externer Seiten sind deren Betreiber verantwortlich.
        </p>

        <h3>Stand</h3>
        <p>21. August 2026</p>
      </aside>
    </div>
  </section>

  <CtaBand
    eyebrow="Kontakt"
    title="Du brauchst eine schnelle Auskunft?"
    text="Schreib uns am besten mit kurzem Betreff. Bei Fundtieren bitte Fundort, Uhrzeit, Zustand und eine Rückrufmöglichkeit nennen."
    href="/kontakt"
    label="Zur Kontaktseite"
  />
</BaseLayout>
