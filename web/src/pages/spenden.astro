---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import ContentBand from "../components/ContentBand.astro";
import CtaBand from "../components/CtaBand.astro";

const donationAmounts = [
  {
    amount: "10 €",
    title: "Körnerfutter",
    text: "hilft bei Futter und laufender Versorgung."
  },
  {
    amount: "25 €",
    title: "Verbrauchsmaterial",
    text: "hilft bei Handschuhen, Küchenrolle, Einstreu und Reinigungsmaterial."
  },
  {
    amount: "50 €",
    title: "Akute Notfälle",
    text: "hilft bei tierärztlichen Kosten, Medikamenten oder einem akuten Fundtier."
  }
];
---

<BaseLayout
  title="Spenden"
  description="Stadttaubenhilfe Bernau braucht Unterstützung für Futter, tierärztliche Kosten, Reinigung, Ausstattung und das Taubenhaus im Fahrradparkhaus."
  theme="donate"
>
  <PageHero
    eyebrow="Unterstützen"
    title="Spenden für Futter, Pflege und tierärztliche Kosten"
    text="Unsere Arbeit kostet jede Woche Geld: Futter, Einstreu, Handschuhe, Reinigungsmaterial, Transportboxen, Medikamente und Besuche bei Tierärzt:innen. Spenden helfen direkt im Taubenhaus und bei Fundtieren in Bernau und Umgebung."
    primaryHref="/kontakt"
    primaryLabel="Spendenmöglichkeit anfragen"
    secondaryHref="/mitmachen"
    secondaryLabel="Ehrenamtlich helfen"
    visualLabel="Zwei betreute Stadttauben"
    imageSrc="/images/gallery/pflegestelle-paar-02.jpg"
    imageAlt="Zwei betreute Stadttauben aus einer Pflegestelle"
    imagePosition="center 38%"
    mobileImagePosition="center 28%"
  />

  <ContentBand
    tone="coral"
    eyebrow="Direkte Wirkung in Bernau"
    title="Deine Hilfe wird ganz praktisch."
    text="Aus einer Spende werden Futter im Napf, eine saubere Box, eine Fahrt oder der nächste tierärztliche Termin. So bleibt Hilfe möglich, wenn sie gebraucht wird."
    imageSrc="/images/gallery/taubenhaus-betreute-tauben-01.jpg"
    imageAlt="Betreute Stadttauben im Taubenhaus"
    imagePosition="center 44%"
    features={[
      { icon: "euro", title: "Versorgung", text: "Körnerfutter, Wasserstellen, Einstreu und Verbrauchsmaterial." },
      { icon: "care", title: "Notfälle", text: "Medikamente, Transporte und Tierarztkosten bei akuter Hilfe." },
      { icon: "home", title: "Taubenhaus", text: "Reinigung, Schutzkleidung und Pflege des betreuten Orts." }
    ]}
  />

  <section class="section section-tight">
    <div class="container">
      <SectionHeader
        eyebrow="Wofür"
        title="Wofür werden Spenden gebraucht?"
      />
      <div class="grid grid-3 topic-grid">
        <Card title="Futter & Versorgung" tone="blue" icon="euro">
          <p>Geeignetes Taubenfutter, Wasserstellen, Einstreu und laufendes Verbrauchsmaterial.</p>
        </Card>
        <Card title="Tierärzt:innen & Fundtiere" tone="green" icon="care">
          <p>Behandlungen, Medikamente, Pflegeplätze, Transport und akute Hilfe für verletzte Tiere.</p>
        </Card>
        <Card title="Taubenhaus & Reinigung" tone="violet" icon="home">
          <p>Schutzkleidung, Schaber, Desinfektion, Reparaturen und Ausstattung für den betreuten Standort.</p>
        </Card>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container donation-amounts">
      <div>
        <span class="eyebrow">Direkte Wirkung</span>
        <h2>Schon kleine Beträge werden zu praktischer Hilfe.</h2>
      </div>
      <div class="donation-grid">
        {donationAmounts.map((item) => (
          <article class="donation-card">
            <strong>{item.amount}</strong>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight" id="sachspenden">
    <div class="container donation-note">
      <div>
        <span class="eyebrow">Geld, Material oder regelmäßige Hilfe</span>
        <h2>Der Spendenweg wird gerade eingerichtet.</h2>
      </div>
      <p>Bankverbindung, PayPal oder Formular werden ergänzt. Bis dahin schreib uns mit dem Stichwort Spende. Auch Handtücher, Küchenrolle, Einmalhandschuhe, Kartons, Transportboxen, Reinigungsmaterial oder geeignetes Taubenfutter können helfen – bitte vorher kurz nachfragen.</p>
      <a class="button button-primary" href="/kontakt">Spendenweg anfragen</a>
    </div>
  </section>

  <CtaBand
    eyebrow="Regelmäßig unterstützen"
    title="Planbare Hilfe gibt Sicherheit."
    text="Wenn du Futter, Material, Volieren oder tierärztliche Notfälle langfristig mittragen möchtest, freuen wir uns über deine Nachricht."
    href="/kontakt"
    label="Patenschaft anfragen"
  />
</BaseLayout>
