---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import ContentBand from "../components/ContentBand.astro";
import CtaBand from "../components/CtaBand.astro";
---

<BaseLayout
  title="Spenden"
  description="Stadttaubenhilfe Bernau braucht Unterstützung für Futter, tierärztliche Kosten, Reinigung, Ausstattung und das Taubenhaus im Fahrradparkhaus."
  theme="donate"
>
  <PageHero
    eyebrow="Unterstützen"
    title="Deine Spende wird zu konkreter Hilfe in Bernau."
    text="Futter, Einstreu, Handschuhe, Transportboxen, Medikamente, Fahrten und tierärztliche Behandlungen fallen nicht irgendwann an – sondern jede Woche. Deine Unterstützung hilft genau dort, wo sie gebraucht wird: im Taubenhaus, in der Pflege und bei akuten Fundtieren."
    primaryHref="/kontakt"
    primaryLabel="Spendenmöglichkeit anfragen"
    secondaryHref="/mitmachen"
    secondaryLabel="Ehrenamtlich helfen"
    visualLabel="Zwei betreute Stadttauben"
    imageSrc="/images/gallery/pflegestelle-paar-02.jpg"
    imageAlt="Zwei betreute Stadttauben aus einer Pflegestelle"
    imagePosition="center 38%"
    mobileImagePosition="center 28%"
  />

  <ContentBand
    tone="coral"
    eyebrow="Direkte Wirkung in Bernau"
    title="Deine Hilfe wird zu konkreter Versorgung."
    text="Aus einer Spende werden Futter im Napf, eine saubere Box, eine Fahrt oder der nächste tierärztliche Termin. So bleibt Hilfe möglich, wenn sie gebraucht wird."
    imageSrc="/images/gallery/taubenhaus-betreute-tauben-01.jpg"
    imageAlt="Betreute Stadttauben im Taubenhaus"
    imagePosition="center 44%"
    features={[
      { icon: "euro", title: "Versorgung", text: "Körnerfutter, Wasserstellen, Einstreu und Verbrauchsmaterial." },
      { icon: "care", title: "Notfälle", text: "Medikamente, Transporte und Tierarztkosten bei akuter Hilfe." },
      { icon: "home", title: "Taubenhaus", text: "Reinigung, Schutzkleidung und Pflege des betreuten Orts." }
    ]}
  />

  <section class="section section-tight">
    <div class="container">
      <SectionHeader
        eyebrow="Wofür"
        title="Wofür werden Spenden gebraucht?"
      />
      <div class="grid grid-3 topic-grid">
        <Card title="10 € · Versorgung" tone="blue" icon="euro">
          <p>Unterstützen Futter, Wasser, Einstreu und Verbrauchsmaterial am betreuten Standort.</p>
        </Card>
        <Card title="25 € · Pflege & Reinigung" tone="green" icon="care">
          <p>Helfen bei Handschuhen, Küchenrolle, Desinfektion, Schutzmaterial und Transportboxen.</p>
        </Card>
        <Card title="50 € · Akute Hilfe" tone="violet" icon="home">
          <p>Beteiligen sich an Medikamenten, Fahrten oder tierärztlicher Versorgung eines Fundtiers.</p>
        </Card>
      </div>
    </div>
  </section>

  <section class="section section-tight" id="sachspenden">
    <div class="container donation-note">
      <div>
        <span class="eyebrow">Geld, Material oder regelmäßige Hilfe</span>
        <h2>Spendenmöglichkeit anfragen.</h2>
      </div>
      <p>Auch saubere Handtücher, Küchenrolle, Einmalhandschuhe, geeignete Kartons oder Transportboxen, Taubenfutter und Reinigungsmaterial können helfen. Bitte frag kurz an, damit Material wirklich passt und gelagert werden kann.</p>
      <a class="button button-primary" href="/kontakt">Spendenmöglichkeit anfragen</a>
    </div>
  </section>

  <CtaBand
    eyebrow="Regelmäßig unterstützen"
    title="Wir arbeiten ehrenamtlich. Hilfe wirkt direkt vor Ort."
    text="Spenden fließen in Versorgung, Pflege und Organisation der Stadttaubenhilfe in Bernau. Wenn du regelmäßig unterstützen möchtest, freuen wir uns über deine Nachricht."
    href="/kontakt"
    label="Spendenmöglichkeit anfragen"
  />
</BaseLayout>
