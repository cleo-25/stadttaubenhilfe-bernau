---
import home from "../data/home-entwurf.json";
import settings from "../data/settings.json";

type NavItem = {
  label: string;
  href: string;
  items?: NavItem[];
};

type WorkItem = {
  title: string;
  text: string;
  icon: "heart" | "home" | "message" | "shield" | "hand" | "leaf";
};

type StatItem = {
  value: string;
  label: string;
  note: string;
};

type StoryItem = {
  title: string;
  text: string;
  image: string;
  alt: string;
};

type ProofItem = {
  value: string;
  label: string;
};

const navItems = settings.navigation as NavItem[];
const workItems = home.work.items as WorkItem[];
const proofItems = home.proofItems as ProofItem[];
const stories = home.stories.items as (StoryItem & { href?: string; linkLabel?: string })[];
const brand = settings.brand;

const iconPath = {
  heart: "M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z",
  home: "m3 10.5 9-7 9 7V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10.5Z",
  message: "M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v8Z",
  shield: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z",
  hand: "M8 11V7a2 2 0 1 1 4 0v4m0-2V6a2 2 0 1 1 4 0v7m0-2V8a2 2 0 1 1 4 0v8a6 6 0 0 1-6 6h-3.5a6 6 0 0 1-4.24-1.76L3 17a2.12 2.12 0 0 1 3-3l2 2",
  leaf: "M11 20A7 7 0 0 1 4 13c0-5 5-9 16-9 0 11-4 16-9 16Zm0 0c0-4 3-7 7-9"
};

const emergencyStyle = `--emergency-image: url("${home.emergency.backgroundImage}")`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{home.meta.title}</title>
    <meta
      name="description"
      content={home.meta.description}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#8CB2E1" />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>

    <div class="site-shell">
      <header class="site-header" aria-label="Hauptnavigation">
        <a class="brand" href="/entwurf" aria-label="Stadttaubenhilfe Bernau Entwurf">
          <img src={brand.logo} alt="" />
          <span>
            <strong>{brand.name}</strong>
            <small>{brand.suffix}</small>
          </span>
        </a>

        <nav class="desktop-nav" aria-label="Navigation">
          {navItems.map((item) => (
            item.items?.length ? (
              <details class="desktop-nav-group">
                <summary>{item.label}</summary>
                <div class="desktop-subnav">
                  {item.items.map((subitem) => <a href={subitem.href}>{subitem.label}</a>)}
                </div>
              </details>
            ) : (
              <a href={item.href}>{item.label}</a>
            )
          ))}
        </nav>

        <a class="nav-cta" href="#unterstuetzen">Jetzt helfen</a>

        <details class="mobile-menu">
          <summary aria-label="Menü öffnen">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="mobile-menu-panel">
            {navItems.map((item) => (
              item.items?.length ? (
                <details>
                  <summary>{item.label}</summary>
                  <div>
                    {item.items.map((subitem) => <a href={subitem.href}>{subitem.label}</a>)}
                  </div>
                </details>
              ) : (
                <a href={item.href}>{item.label}</a>
              )
            ))}
          </div>
        </details>
      </header>

      <main id="main">
        <section class="hero section-reveal">
          <div class="hero-copy">
            <div class="hero-mark">
              <img src={brand.logo} alt="" />
              <span>{home.hero.badge}</span>
            </div>
            <p class="context-line">{home.hero.kicker}</p>
            <h1>{home.hero.title}</h1>
            <p class="hero-text">{home.hero.text}</p>
            <div class="hero-actions">
              <a class="button button-primary" href={home.hero.primaryHref}>{home.hero.primaryLabel}</a>
              <a class="button button-secondary" href={home.hero.secondaryHref}>{home.hero.secondaryLabel}</a>
            </div>
          </div>

          <figure class="hero-image hero-image-main">
            <img
              src={home.hero.image}
              alt={home.hero.imageAlt}
              loading="eager"
              decoding="async"
            />
            <figcaption>
              <strong>{home.hero.captionTitle}</strong>
              <span>{home.hero.captionText}</span>
            </figcaption>
          </figure>
        </section>

        <section class="proof-strip section-reveal" aria-label="Kurzüberblick">
          {proofItems.map((item) => (
            <article>
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </article>
          ))}
        </section>

        <section class="mission section-reveal" id="mission">
          <figure class="mission-image">
            <img
              src={home.mission.image}
              alt={home.mission.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="mission-copy">
            <p class="section-kicker">{home.mission.kicker}</p>
            <h2>{home.mission.title}</h2>
            {home.mission.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="work section-reveal" id="arbeit">
          <div class="section-heading">
            <p class="section-kicker">{home.work.kicker}</p>
            <h2>{home.work.title}</h2>
            <p>{home.work.text}</p>
          </div>

          <div class="work-grid">
            {workItems.map((item, index) => (
              <article class="work-card">
                <span class="work-number">0{index + 1}</span>
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <path d={iconPath[item.icon]}></path>
                </svg>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="emergency section-reveal" id="notfall" style={emergencyStyle}>
          <div class="emergency-copy">
            <p class="section-kicker">{home.emergency.kicker}</p>
            <h2>{home.emergency.title}</h2>
            <p>{home.emergency.text}</p>
            <a class="button button-primary" href={home.emergency.buttonHref}>{home.emergency.buttonLabel}</a>
          </div>

          <ol class="steps" aria-label="Erste Schritte bei einem Fundtier">
            {home.emergency.steps.map((step, index) => (
              <li>
                <span>{index + 1}</span>
                <div>
                  <strong>{step.title}</strong>
                  <p>{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="impact section-reveal" id="wirkung">
          <div class="impact-image">
            <img
              src={home.impact.image}
              alt={home.impact.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="impact-copy">
            <p class="section-kicker">{home.impact.kicker}</p>
            <h2>{home.impact.title}</h2>
            <p>{home.impact.text}</p>
            <div class="impact-lead" aria-label="Über 700 Eier pro Jahr">
              <strong>{home.impact.lead.value}</strong>
              <span>{home.impact.lead.label}</span>
            </div>
            <div class="stat-grid">
              {home.impact.stats.map((stat) => (
                <article class="stat-card">
                  <strong>{stat.value}</strong>
                  <span>{stat.label}</span>
                  <small>{stat.note}</small>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="stories section-reveal" id="geschichten">
          <div class="section-heading">
            <p class="section-kicker">{home.stories.kicker}</p>
            <h2>{home.stories.title}</h2>
            <p>{home.stories.text}</p>
          </div>

          <div class="story-grid">
            {stories.map((story) => (
              <article class="story-card">
                <img src={story.image} alt={story.alt} loading="lazy" decoding="async" />
                <div>
                  <h3>{story.title}</h3>
                  <p>{story.text}</p>
                  <a href={story.href ?? "/galerie"}>{story.linkLabel ?? "Mehr ansehen"}</a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="support section-reveal" id="unterstuetzen">
          <div class="support-intro">
            <p class="section-kicker">{home.support.kicker}</p>
            <h2>{home.support.title}</h2>
            <p>{home.support.text}</p>
          </div>

          <figure class="support-image">
            <img
              src={home.support.image}
              alt={home.support.imageAlt}
              loading="lazy"
              decoding="async"
            />
          </figure>

          <div class="support-grid">
            {home.support.items.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <a href={item.href}>{item.linkLabel}</a>
              </article>
            ))}
          </div>
        </section>

        <section class="news section-reveal" id="aktuelles">
          <div class="section-heading">
            <p class="section-kicker">{home.news.kicker}</p>
            <h2>{home.news.title}</h2>
          </div>

          <div class="news-grid">
            {home.news.items.map((item) => (
              <article>
                <span>{item.label}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>
      </main>

      <footer class="footer">
        <div>
          <img src={brand.logo} alt="" />
          <strong>{brand.name} Bernau</strong>
          <p>{home.footer.description}</p>
        </div>
        <nav aria-label="Footer Links">
          <a href="/kontakt">Kontakt</a>
          <a href="/spenden">Spenden</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </nav>
        <div>
          <strong>Kontakt</strong>
          <p>{settings.contact.email}</p>
          <p>Instagram: {settings.contact.instagramLabel}</p>
          <p>Spendenkonto wird ergänzt.</p>
        </div>
      </footer>
    </div>

    <a class="floating-cta" href={home.floatingCta.href}>{home.floatingCta.label}</a>
  </body>
</html>

<style>
  :root {
    --pigeon: #8cb2e1;
    --pigeon-strong: #5f8fca;
    --ink: #23354d;
    --muted: #627186;
    --offwhite: #f7f8f6;
    --sand: #ece9e3;
    --mist: #f3f5f7;
    --sage: #a7bda0;
    --copper: #d58a42;
    --surface: #ffffff;
    --line: rgba(35, 53, 77, 0.12);
    --shadow: 0 18px 50px rgba(35, 53, 77, 0.10);
    --shadow-soft: 0 8px 26px rgba(35, 53, 77, 0.08);
    --radius: 18px;
    --radius-sm: 14px;
    color: var(--ink);
    background: var(--offwhite);
    font-family:
      Manrope, Avenir Next, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background:
      radial-gradient(circle at 78% 0%, rgba(140, 178, 225, 0.30), transparent 34rem),
      linear-gradient(180deg, #fbfcfb 0%, var(--offwhite) 44%, #eef4f8 100%);
    color: var(--ink);
    overflow-x: hidden;
  }

  body,
  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  :focus-visible {
    outline: 3px solid rgba(140, 178, 225, 0.86);
    outline-offset: 4px;
  }

  .skip-link {
    position: fixed;
    top: 14px;
    left: 14px;
    z-index: 30;
    transform: translateY(-150%);
    border-radius: 999px;
    background: var(--ink);
    color: white;
    padding: 10px 14px;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-shell {
    width: min(100%, 1680px);
    margin-inline: auto;
    overflow: clip;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: clamp(12px, 2vw, 28px);
    min-height: 76px;
    border-bottom: 1px solid var(--line);
    background: rgba(247, 248, 246, 0.92);
    padding: 12px clamp(18px, 5vw, 72px);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: max-content;
  }

  .brand img {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: contain;
  }

  .brand strong,
  .brand small {
    display: block;
    line-height: 1.05;
  }

  .brand strong {
    font-size: 0.98rem;
    font-weight: 850;
  }

  .brand small {
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .desktop-nav {
    display: flex;
    justify-content: center;
    gap: 2px;
  }

  .desktop-nav a,
  .desktop-nav summary,
  .nav-cta,
  .mobile-menu-panel a,
  .mobile-menu-panel summary,
  .button,
  .floating-cta {
    min-height: 44px;
    border-radius: 999px;
    font-weight: 800;
  }

  .desktop-nav a,
  .desktop-nav summary {
    display: inline-flex;
    align-items: center;
    color: #33455c;
    cursor: pointer;
    font-size: clamp(0.78rem, 0.72vw, 0.9rem);
    list-style: none;
    padding: 10px clamp(8px, 0.8vw, 13px);
    transition: background 220ms ease, color 220ms ease;
  }

  .desktop-nav summary::-webkit-details-marker {
    display: none;
  }

  .desktop-nav-group {
    position: relative;
  }

  .desktop-nav-group summary::after {
    content: "";
    width: 7px;
    height: 7px;
    margin-left: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }

  .desktop-subnav {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    z-index: 10;
    display: grid;
    min-width: 250px;
    transform: translateX(-50%);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow);
    padding: 8px;
  }

  .desktop-subnav a {
    justify-content: flex-start;
    min-height: 38px;
    border-radius: 12px;
    white-space: nowrap;
  }

  .desktop-nav a:hover,
  .desktop-nav summary:hover,
  .desktop-nav-group[open] summary {
    background: rgba(140, 178, 225, 0.18);
    color: var(--ink);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--pigeon);
    color: var(--ink);
    padding: 10px 18px;
    box-shadow: 0 10px 24px rgba(140, 178, 225, 0.34);
  }

  .mobile-menu {
    display: none;
    position: relative;
  }

  .mobile-menu summary {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgba(35, 53, 77, 0.12);
    border-radius: 999px;
    background: white;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary span {
    width: 20px;
    height: 2px;
    border-radius: 999px;
    background: var(--ink);
  }

  .mobile-menu-panel {
    position: fixed;
    right: 16px;
    left: 16px;
    top: 86px;
    display: grid;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow);
    padding: 12px;
  }

  .mobile-menu-panel a {
    display: flex;
    align-items: center;
    padding: 10px 12px;
  }

  .mobile-menu-panel details {
    border-radius: 16px;
  }

  .mobile-menu-panel summary {
    display: flex;
    align-items: center;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    padding: 10px 12px;
  }

  .mobile-menu-panel summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-panel details div {
    display: grid;
    gap: 3px;
    padding: 0 0 8px 14px;
  }

  .mobile-menu-panel details a {
    min-height: 38px;
    color: var(--muted);
  }

  main {
    display: grid;
  }

  .hero,
  .mission,
  .work,
  .emergency,
  .impact,
  .stories,
  .support,
  .news,
  .footer {
    padding-inline: clamp(20px, 5vw, 88px);
  }

  .hero {
    display: grid;
    align-items: center;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.98fr);
    min-height: min(860px, calc(100svh - 76px));
    gap: clamp(28px, 6vw, 86px);
    padding-block: clamp(44px, 6vw, 86px);
  }

  .hero-copy,
  .hero-image,
  .emergency-copy,
  .impact-copy,
  .support-intro,
  .section-heading {
    min-width: 0;
  }

  .context-line,
  .section-kicker {
    margin: 0 0 16px;
    color: #52657d;
    font-size: 0.84rem;
    font-weight: 850;
    letter-spacing: 0.02em;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    color: var(--ink);
    letter-spacing: -0.025em;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-wrap: balance;
  }

  h1 {
    max-width: 820px;
    margin-bottom: 26px;
    font-size: clamp(3.05rem, 5.85vw, 5.25rem);
    line-height: 1;
  }

  h2 {
    margin-bottom: 18px;
    font-size: clamp(2.15rem, 4.4vw, 4.6rem);
    line-height: 1;
  }

  h3 {
    margin-bottom: 10px;
    font-size: 1.13rem;
    line-height: 1.16;
  }

  p {
    color: var(--muted);
    line-height: 1.72;
    text-wrap: pretty;
  }

  .hero-text {
    max-width: 640px;
    margin-bottom: 34px;
    font-size: clamp(1.05rem, 1.5vw, 1.22rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    padding: 13px 20px;
    white-space: normal;
    transition: transform 220ms ease, box-shadow 220ms ease, background 220ms ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--ink);
    color: white;
    box-shadow: 0 16px 34px rgba(35, 53, 77, 0.18);
  }

  .button-secondary {
    border: 1px solid rgba(35, 53, 77, 0.14);
    background: rgba(255, 255, 255, 0.72);
    color: var(--ink);
  }

  .hero-image {
    position: relative;
    min-height: clamp(420px, 58vw, 720px);
    overflow: hidden;
    margin: 0;
    border-radius: 20px;
    background: var(--sand);
    box-shadow: var(--shadow);
    clip-path: ellipse(88% 100% at 58% 50%);
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: center 42%;
  }

  .mission {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 6vw, 86px);
    border-block: 1px solid var(--line);
    background: var(--surface);
    padding-block: clamp(72px, 9vw, 130px);
  }

  .mission-copy {
    display: grid;
    gap: 18px;
    max-width: 780px;
  }

  .mission-copy p {
    margin: 0;
    font-size: clamp(1.08rem, 1.7vw, 1.34rem);
    line-height: 1.68;
  }

  .section-heading {
    max-width: 840px;
    margin-bottom: clamp(30px, 5vw, 58px);
  }

  .section-heading p:not(.section-kicker),
  .support-intro p {
    max-width: 700px;
    font-size: 1.06rem;
  }

  .work,
  .stories,
  .news {
    padding-block: clamp(78px, 10vw, 144px);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .work-card,
  .support-grid article,
  .news-grid article,
  .stat-card {
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.76);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.7) inset;
  }

  .work-card {
    min-height: 246px;
    padding: clamp(22px, 3vw, 34px);
  }

  .work-card svg {
    width: 30px;
    height: 30px;
    margin-bottom: 42px;
    fill: none;
    stroke: var(--pigeon-strong);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .work-card p,
  .support-grid p,
  .news-grid p {
    margin-bottom: 0;
    font-size: 0.98rem;
  }

  .emergency {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(24px, 6vw, 88px);
    align-items: center;
    background:
      linear-gradient(90deg, rgba(247, 248, 246, 0.94), rgba(236, 233, 227, 0.72)),
      var(--emergency-image) right center / cover no-repeat;
    padding-block: clamp(78px, 10vw, 148px);
  }

  .emergency-copy {
    max-width: 560px;
  }

  .steps {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 18px;
    align-items: start;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.86);
    padding: 18px;
    box-shadow: var(--shadow-soft);
  }

  .steps span {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    background: var(--pigeon);
    color: var(--ink);
    font-weight: 900;
  }

  .steps strong {
    display: block;
    margin-bottom: 4px;
    color: var(--ink);
  }

  .steps p {
    margin-bottom: 0;
  }

  .impact {
    display: grid;
    grid-template-columns: minmax(320px, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(26px, 6vw, 88px);
    align-items: center;
    padding-block: clamp(78px, 10vw, 144px);
  }

  .impact-image {
    overflow: hidden;
    border-radius: 20px;
    box-shadow: var(--shadow);
  }

  .impact-image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
  }

  .stat-card {
    padding: 22px;
  }

  .stat-card strong {
    display: block;
    color: var(--ink);
    font-size: clamp(2.1rem, 5vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .stat-card span,
  .stat-card small {
    display: block;
  }

  .stat-card span {
    margin-top: 10px;
    color: var(--ink);
    font-weight: 850;
  }

  .stat-card small {
    margin-top: 3px;
    color: var(--muted);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr 0.9fr;
    gap: 14px;
  }

  .story-card {
    overflow: hidden;
    border-radius: 20px;
    background: white;
    box-shadow: var(--shadow-soft);
  }

  .story-card:first-child {
    grid-row: span 2;
  }

  .story-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .story-card:first-child img {
    aspect-ratio: 4 / 5;
  }

  .story-card div {
    padding: 22px;
  }

  .story-card a,
  .support-grid a {
    display: inline-flex;
    margin-top: 14px;
    color: var(--pigeon-strong);
    font-weight: 850;
  }

  .support {
    display: grid;
    grid-template-columns: minmax(0, 0.74fr) minmax(0, 1.26fr);
    gap: clamp(26px, 6vw, 88px);
    align-items: start;
    background: var(--ink);
    padding-block: clamp(78px, 10vw, 140px);
  }

  .support h2,
  .support h3,
  .support .section-kicker {
    color: white;
  }

  .support p {
    color: rgba(255, 255, 255, 0.76);
  }

  .support-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .support-grid article {
    background: rgba(255, 255, 255, 0.08);
    padding: 24px;
  }

  .support-grid a {
    color: #dbeaff;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .news-grid article {
    padding: 24px;
  }

  .news-grid span {
    display: inline-flex;
    margin-bottom: 42px;
    border-radius: 999px;
    background: rgba(140, 178, 225, 0.18);
    color: #476987;
    font-size: 0.78rem;
    font-weight: 850;
    padding: 7px 10px;
  }

  .footer {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1fr;
    gap: 36px;
    background: #dbeaff;
    padding-block: 54px;
  }

  .footer img {
    width: 52px;
    height: 52px;
    margin-bottom: 16px;
    border-radius: 50%;
  }

  .footer strong {
    display: block;
    color: var(--ink);
    margin-bottom: 8px;
  }

  .footer nav {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .footer p {
    max-width: 360px;
    margin-bottom: 6px;
  }

  .floating-cta {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 25;
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: white;
    padding: 12px 16px;
    box-shadow: 0 10px 20px rgba(35, 53, 77, 0.18);
  }

  .section-reveal {
    animation: section-in 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes section-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .section-reveal,
    .button,
    .desktop-nav a {
      animation: none;
      transition: none;
    }
  }

  @media (max-width: 1120px) {
    .desktop-nav {
      display: none;
    }

    .site-header {
      grid-template-columns: auto 1fr auto auto;
    }

    .mobile-menu {
      display: block;
    }

    .hero,
    .mission,
    .emergency,
    .impact,
    .support,
    .footer {
      grid-template-columns: 1fr;
    }

    .work-grid,
    .story-grid,
    .news-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .story-card:first-child {
      grid-row: auto;
    }
  }

  @media (max-width: 720px) {
    .site-shell,
    main,
    .hero,
    .hero-copy,
    .hero-image,
    .mission,
    .work,
    .emergency,
    .impact,
    .stories,
    .support,
    .news,
    .footer {
      width: 100%;
      max-width: 100%;
    }

    .site-header {
      min-height: 68px;
      padding: 10px 14px;
      grid-template-columns: auto 1fr auto;
    }

    .brand img {
      width: 38px;
      height: 38px;
    }

    .brand strong {
      font-size: 0.94rem;
    }

    .brand small {
      font-size: 0.78rem;
    }

    .nav-cta {
      display: none;
    }

    .hero,
    .mission,
    .work,
    .emergency,
    .impact,
    .stories,
    .support,
    .news,
    .footer {
      padding-inline: 18px;
    }

    .hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: auto;
      padding-block: 38px 64px;
      overflow: hidden;
    }

    .hero-copy,
    .hero-image {
      max-width: calc(100vw - 36px);
    }

    h1 {
      max-width: 100%;
      font-size: clamp(2.05rem, 8.8vw, 2.72rem);
      line-height: 1.06;
      text-wrap: balance;
    }

    h2 {
      font-size: clamp(2rem, 9vw, 3rem);
    }

    .context-line,
    .hero-text {
      width: calc(100vw - 36px);
      max-width: calc(100vw - 36px);
      text-wrap: auto;
    }

    .hero-text {
      font-size: 1rem;
    }

    .hero-actions {
      display: grid;
      width: calc(100vw - 36px);
      max-width: calc(100vw - 36px);
    }

    .button {
      width: 100%;
    }

    .hero-image {
      width: calc(100vw - 36px);
      min-height: 0;
      aspect-ratio: 4 / 5;
      clip-path: none;
    }

    .hero-image img {
      min-height: 0;
      height: 100%;
    }

    .work-grid,
    .story-grid,
    .support-grid,
    .news-grid,
    .stat-grid {
      grid-template-columns: 1fr;
    }

    .floating-cta {
      display: inline-flex;
      right: 12px;
      bottom: 12px;
      max-width: calc(100vw - 24px);
      min-height: 36px;
      padding: 7px 11px;
      font-size: 0.82rem;
    }
  }

  /* Impeccable color pass: light pigeon-blue leads; dark tones become readable ink only. */
  :root {
    --pigeon: #8cb2e1;
    --pigeon-deep: #3f83b8;
    --pigeon-title: #2f73a6;
    --pigeon-ink: #284763;
    --pigeon-soft: #e5f0fb;
    --pigeon-wash: #f1f7fe;
    --pigeon-panel: #d8e8f8;
    --pigeon-panel-strong: #c3daf3;
    --green-soft: #e6f2e8;
    --surface: #ffffff;
    --ink: #263f58;
    --muted: #526b83;
    --line: rgba(63, 131, 184, 0.24);
    --shadow: 0 20px 44px rgba(63, 131, 184, 0.14);
    --shadow-soft: 0 10px 22px rgba(63, 131, 184, 0.09);
    --radius: 16px;
  }

  body {
    background:
      radial-gradient(circle at 6% 8%, rgba(140, 178, 225, 0.5), transparent 30rem),
      radial-gradient(circle at 90% 24%, rgba(195, 218, 243, 0.72), transparent 34rem),
      linear-gradient(180deg, #f8fbff 0%, #edf5fd 42%, #ffffff 100%);
  }

  .site-shell {
    width: 100%;
    max-width: 1920px;
  }

  .site-header {
    min-height: 82px;
    border-bottom-color: rgba(63, 131, 184, 0.16);
    background: rgba(248, 251, 255, 0.9);
    padding-inline: clamp(20px, 5vw, 96px);
  }

  .brand img {
    width: 48px;
    height: 48px;
  }

  .brand strong {
    color: var(--pigeon-ink);
    font-size: 1.02rem;
  }

  .desktop-nav {
    gap: 10px;
  }

  .desktop-nav a {
    color: rgba(40, 71, 99, 0.78);
    font-size: 0.92rem;
    padding-inline: 14px;
  }

  .desktop-nav a:hover {
    background: rgba(140, 178, 225, 0.22);
    color: var(--pigeon-title);
  }

  .nav-cta {
    background: linear-gradient(135deg, #a5c6ec, var(--pigeon));
    color: #173451;
    box-shadow: 0 12px 24px rgba(63, 131, 184, 0.2);
  }

  .button,
  .nav-cta {
    transition:
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1),
      background 240ms ease,
      color 240ms ease;
  }

  .button:hover,
  .nav-cta:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: linear-gradient(135deg, #9fc3eb, var(--pigeon));
    color: #173451;
    box-shadow: 0 16px 28px rgba(63, 131, 184, 0.2);
  }

  .button-secondary {
    border: 0;
    background: rgba(255, 255, 255, 0.78);
    color: var(--pigeon-ink);
  }

  .hero,
  .mission,
  .work,
  .emergency,
  .impact,
  .stories,
  .support,
  .news,
  .footer,
  .proof-strip {
    padding-inline: clamp(20px, 6vw, 112px);
  }

  .hero {
    position: relative;
    grid-template-columns: minmax(0, 0.88fr) minmax(420px, 1.12fr);
    min-height: min(900px, calc(100svh - 82px));
    gap: clamp(32px, 7vw, 112px);
    padding-block: clamp(64px, 8vw, 118px);
  }

  .hero::before {
    position: absolute;
    inset: 7% 0 auto auto;
    width: min(42vw, 560px);
    height: min(42vw, 560px);
    border-radius: 999px;
    background: radial-gradient(circle, rgba(140, 178, 225, 0.58), rgba(140, 178, 225, 0));
    content: "";
    pointer-events: none;
  }

  .hero-mark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    margin-bottom: clamp(28px, 4vw, 52px);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.78);
    color: var(--pigeon-ink);
    font-size: 0.95rem;
    font-weight: 850;
    padding: 8px 16px 8px 8px;
  }

  .hero-mark img {
    width: clamp(54px, 6vw, 86px);
    height: clamp(54px, 6vw, 86px);
    border-radius: 50%;
    background: white;
    object-fit: contain;
  }

  .context-line {
    max-width: 48ch;
    margin-bottom: 14px;
    color: var(--pigeon-title);
    font-size: 1.02rem;
    font-weight: 850;
  }

  h1 {
    max-width: 820px;
    color: var(--pigeon-title);
    font-size: clamp(3.4rem, 6.6vw, 6rem);
    letter-spacing: -0.032em;
  }

  h2 {
    color: var(--pigeon-title);
    letter-spacing: -0.028em;
  }

  .hero-text {
    max-width: 620px;
    color: #425f78;
    font-size: clamp(1.08rem, 1.3vw, 1.28rem);
    line-height: 1.75;
  }

  .hero-image {
    min-height: clamp(520px, 58vw, 780px);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    clip-path: none;
  }

  .hero-image-main {
    isolation: isolate;
  }

  .hero-image-main::before {
    position: absolute;
    inset: 8% -3% -4% 8%;
    z-index: -1;
    border-radius: 46% 54% 42% 58% / 48% 42% 58% 52%;
    background:
      linear-gradient(145deg, rgba(140, 178, 225, 0.95), rgba(216, 232, 248, 0.92));
    content: "";
  }

  .hero-image img {
    min-height: inherit;
    border-radius: 42% 58% 48% 52% / 54% 44% 56% 46%;
    box-shadow: var(--shadow);
    object-position: center 45%;
  }

  .hero-image figcaption {
    position: absolute;
    right: clamp(10px, 2vw, 26px);
    bottom: clamp(10px, 2vw, 26px);
    max-width: 260px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.94);
    color: var(--pigeon-ink);
    padding: 16px 18px;
  }

  .hero-image figcaption strong,
  .hero-image figcaption span {
    display: block;
  }

  .hero-image figcaption span {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .proof-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border-block: 1px solid var(--line);
    background: rgba(63, 131, 184, 0.2);
    padding-block: 0;
  }

  .proof-strip article {
    display: grid;
    gap: 8px;
    min-height: 148px;
    align-content: center;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.78), rgba(216, 232, 248, 0.92));
    color: var(--pigeon-ink);
    padding: clamp(24px, 4vw, 44px);
  }

  .proof-strip strong {
    font-size: clamp(1.7rem, 3vw, 3rem);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .proof-strip span {
    color: #4b6680;
    font-weight: 750;
  }

  .mission {
    grid-template-columns: minmax(280px, 0.86fr) minmax(0, 1.14fr);
    align-items: center;
    border-block: 0;
    background:
      linear-gradient(90deg, rgba(216, 232, 248, 0.86), rgba(255, 255, 255, 0.94)),
      #ffffff;
    padding-block: clamp(88px, 11vw, 168px);
  }

  .mission-image {
    overflow: hidden;
    margin: 0;
    border-radius: 44% 56% 50% 50% / 48% 44% 56% 52%;
  }

  .mission-image img {
    width: 100%;
    min-height: clamp(380px, 44vw, 620px);
    object-fit: cover;
    object-position: center;
  }

  .mission-copy {
    max-width: 780px;
  }

  .section-kicker {
    margin-bottom: 18px;
    color: var(--pigeon-title);
    font-size: 0.95rem;
    letter-spacing: 0;
  }

  .work {
    background: linear-gradient(180deg, #ffffff, var(--pigeon-wash));
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .work-card {
    display: grid;
    grid-template-columns: 76px 52px minmax(180px, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(18px, 4vw, 52px);
    min-height: 0;
    align-items: center;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    padding: clamp(24px, 4vw, 44px) 0;
  }

  .work-number {
    color: rgba(63, 131, 184, 0.54);
    font-size: clamp(1.4rem, 3vw, 2.6rem);
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .work-card svg {
    width: 34px;
    height: 34px;
    margin: 0;
    stroke: var(--pigeon-title);
  }

  .work-card h3 {
    margin: 0;
    font-size: clamp(1.5rem, 2.5vw, 2.4rem);
    letter-spacing: -0.035em;
  }

  .work-card p {
    max-width: 58ch;
    color: var(--muted);
    font-size: 1.04rem;
  }

  .emergency {
    position: relative;
    overflow: hidden;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    background:
      linear-gradient(90deg, rgba(216, 232, 248, 0.96), rgba(140, 178, 225, 0.82)),
      var(--emergency-image) right center / cover no-repeat;
    color: var(--pigeon-ink);
    padding-block: clamp(92px, 11vw, 170px);
  }

  .emergency h2,
  .emergency .section-kicker {
    color: var(--pigeon-ink);
  }

  .emergency p {
    color: rgba(40, 71, 99, 0.82);
  }

  .emergency .button-primary {
    background: #ffffff;
    color: #173451;
    box-shadow: 0 14px 24px rgba(63, 131, 184, 0.18);
  }

  .steps {
    gap: 14px;
  }

  .steps li {
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 10px 20px rgba(63, 131, 184, 0.08);
  }

  .steps p {
    color: var(--muted);
  }

  .impact {
    grid-template-columns: minmax(300px, 0.95fr) minmax(0, 1.05fr);
    background:
      radial-gradient(circle at 70% 16%, rgba(140, 178, 225, 0.38), transparent 28rem),
      var(--pigeon-wash);
    padding-block: clamp(86px, 10vw, 156px);
  }

  .impact-image {
    border-radius: 16px;
    box-shadow: none;
  }

  .impact-image img {
    aspect-ratio: 4 / 4.5;
  }

  .impact-lead {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(18px, 3vw, 32px);
    align-items: end;
    margin: clamp(28px, 4vw, 46px) 0 18px;
    border-radius: 16px;
    background:
      linear-gradient(135deg, var(--pigeon-panel-strong), var(--pigeon));
    color: #173451;
    padding: clamp(24px, 4vw, 38px);
  }

  .impact-lead strong {
    font-size: clamp(4.3rem, 10vw, 9rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
  }

  .impact-lead span {
    max-width: 22ch;
    color: #21435f;
    font-size: clamp(1.08rem, 1.7vw, 1.42rem);
    font-weight: 800;
    line-height: 1.2;
  }

  .stat-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: 0;
    background: rgba(63, 131, 184, 0.18);
  }

  .stat-card {
    border-radius: 0;
    background: white;
    box-shadow: none;
    padding: clamp(18px, 3vw, 28px);
  }

  .stat-card strong {
    color: var(--pigeon-title);
    font-size: clamp(2.1rem, 4vw, 3.6rem);
  }

  .stories {
    background: #ffffff;
  }

  .story-grid {
    grid-template-columns: 1.25fr 0.85fr 0.85fr;
    gap: clamp(14px, 2vw, 22px);
  }

  .story-card {
    border-radius: 16px;
    box-shadow: none;
    background: linear-gradient(180deg, #ffffff, var(--pigeon-wash));
  }

  .story-card img {
    aspect-ratio: 16 / 11;
  }

  .story-card:first-child img {
    aspect-ratio: 4 / 5;
  }

  .support {
    grid-template-columns: minmax(0, 0.62fr) minmax(280px, 0.38fr);
    background:
      radial-gradient(circle at 8% 10%, rgba(255, 255, 255, 0.68), transparent 26rem),
      linear-gradient(135deg, var(--pigeon-panel), var(--pigeon));
    color: var(--pigeon-ink);
    padding-block: clamp(84px, 11vw, 160px);
  }

  .support h2,
  .support h3,
  .support .section-kicker {
    color: var(--pigeon-ink);
  }

  .support p {
    color: rgba(40, 71, 99, 0.78);
  }

  .support-image {
    overflow: hidden;
    margin: 0;
    border-radius: 16px;
  }

  .support-image img {
    width: 100%;
    min-height: 420px;
    object-fit: cover;
  }

  .support-grid {
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(32px, 5vw, 58px);
    background: rgba(63, 131, 184, 0.2);
  }

  .support-grid article {
    border-radius: 0;
    background: rgba(255, 255, 255, 0.82);
    box-shadow: none;
    padding: clamp(22px, 3vw, 34px);
  }

  .support-grid a {
    color: var(--pigeon-title);
  }

