---
import settings from "../data/settings.json";

interface Props {
  mainId?: string;
}

const { mainId = "main-content" } = Astro.props;

const brand = settings.brand;
type NavLink = { label: string; href: string };
type NavHub = { label: string; href: string; items: NavLink[] };
type NavGroup = { label: string; hubs: NavHub[]; href?: string };

const hubs = settings.navigation as NavHub[];
const hub = (label: string) => hubs.find((item) => item.label === label);
const navGroups: NavGroup[] = [
  {
    label: "Hilfe & Beratung",
    hubs: [hub("Taube gefunden?"), hub("Kontakt")].filter(Boolean) as NavHub[]
  },
  {
    label: "Taubenwissen",
    hubs: [
      hub("Stadttauben – die vergessenen Haustiere"),
      hub("Taube gleich Taube?"),
      hub("Stadttaubenmanagement")
    ].filter(Boolean) as NavHub[]
  },
  {
    label: "Über uns",
    hubs: [hub("Unser Verein"), hub("Was wir tun")].filter(Boolean) as NavHub[]
  },
  {
    label: "Mitmachen",
    hubs: [hub("Du willst uns helfen?")].filter(Boolean) as NavHub[]
  },
  { label: "Aktuelles", href: "/galerie", hubs: [] as NavHub[] }
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  const cleanHref = href.split("#")[0] || "/";
  return currentPath === cleanHref || (currentPath === "/taubenhaus" && cleanHref === "/projekte");
};
const isHubActive = (items: NavHub[]) => items.some((item) => isActive(item.href) || item.items.some((child) => isActive(child.href)));
---

<a class="skip-link" href={`#${mainId}`}>Zum Inhalt springen</a>
<div class="emergency-strip">
  <div class="container">
    <strong><span aria-hidden="true">△</span> Taube in Not?</strong>
    <span>Schnell handeln, Leben retten.</span>
    <a href="/fundtiere">Erste Hilfe ansehen →</a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Startseite Stadttaubenhilfe Bernau">
      <span class="brand-mark" aria-hidden="true">
        <img class="brand-logo" src="/images/logo-stadttaubenhilfe-restored-v2.png" alt="" />
      </span>
      <span>
        <strong>{brand.name}</strong>
        <small>Bernau b. Berlin</small>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Navigation öffnen"
      aria-expanded="false"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-nav" aria-label="Hauptnavigation" data-site-nav>
      {navGroups.map((group) => group.hubs.length > 0 ? (
        <details class:list={["site-nav-group", group.hubs.length > 1 && "site-nav-group-wide"]}>
          <summary aria-current={isHubActive(group.hubs) ? "page" : undefined}>{group.label}</summary>
          <div class="site-subnav">
            {group.hubs.map((section) => (
              <section class="site-subnav-hub">
                <a class="site-subnav-title" href={section.href}>
                  <span>{section.label}</span>
                  <b aria-hidden="true">→</b>
                </a>
                {section.items.length > 0 && (
                  <ul>
                    {section.items.map((item) => (
                      <li><a href={item.href}>{item.label}</a></li>
                    ))}
                  </ul>
                )}
              </section>
            ))}
          </div>
        </details>
      ) : (
        <a href={group.href} aria-current={isActive(group.href) ? "page" : undefined}>{group.label}</a>
      ))}
      <a class="site-nav-donate" href="/spenden" aria-current={isActive("/spenden") ? "page" : undefined}>Jetzt helfen <span aria-hidden="true">♥</span></a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-site-nav]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    nav?.classList.toggle("is-open", !isOpen);
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      nav.classList.remove("is-open");
    });
  });

  nav?.querySelectorAll("details").forEach((group) => {
    group.addEventListener("toggle", () => {
      if (!group.open) return;
      nav.querySelectorAll("details").forEach((other) => {
        if (other !== group) other.removeAttribute("open");
      });
    });
  });
</script>

<style is:global>
  .site-header .site-nav-group { position: relative; }

  .site-header .site-nav-group > summary {
    display: inline-flex;
    min-height: 43px;
    align-items: center;
    color: #fff;
    cursor: pointer;
    font-size: .86rem;
    font-weight: 400;
    list-style: none;
    padding: 10px 0;
    white-space: nowrap;
  }

  .site-header .site-nav-group > summary::-webkit-details-marker { display: none; }
  .site-header .site-nav-group > summary::after {
    width: 7px;
    height: 7px;
    margin: -4px 0 0 8px;
    border-right: 2px solid #8cb2e1;
    border-bottom: 2px solid #8cb2e1;
    content: "";
    transform: rotate(45deg);
    transition: transform 180ms ease;
  }
  .site-header .site-nav-group[open] > summary::after { transform: translateY(3px) rotate(225deg); }
  .site-header .site-nav-group > summary:hover,
  .site-header .site-nav-group > summary[aria-current="page"] {
    background: transparent;
    color: #fff;
    box-shadow: inset 0 -2px #8cb2e1;
    transform: none;
  }

  .site-header .site-subnav {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    min-width: 290px;
    gap: 1px;
    border: 1px solid #c9dced;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 14px rgba(13, 41, 66, .16);
    padding: 8px;
  }

  .site-header .site-nav-group-wide .site-subnav {
    width: min(630px, calc(100vw - 48px));
    grid-template-columns: repeat(auto-fit, minmax(185px, 1fr));
    gap: 8px;
  }

  .site-header .site-subnav-hub {
    min-width: 0;
    padding: 8px;
  }

  .site-header .site-nav .site-subnav-title {
    display: flex !important;
    min-height: 0 !important;
    align-items: center;
    justify-content: space-between;
    color: #0d2942 !important;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: .94rem !important;
    font-weight: 700 !important;
    line-height: 1.12;
    padding: 4px 2px 10px !important;
    white-space: normal;
  }

  .site-header .site-nav .site-subnav-title b { color: #5590d1; font-size: 1rem; }
  .site-header .site-subnav ul { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .site-header .site-subnav li { margin: 0; }
  .site-header .site-subnav li a {
    display: block !important;
    min-height: 0 !important;
    color: #315673 !important;
    font-family: "Source Sans 3", sans-serif;
    font-size: .82rem !important;
    font-weight: 600 !important;
    line-height: 1.28;
    padding: 5px 2px !important;
    white-space: normal;
  }

  .site-header .site-subnav a:hover,
  .site-header .site-subnav a:focus-visible {
    box-shadow: none !important;
    color: #0d2942 !important;
    text-decoration: underline;
    text-decoration-color: #f2675c;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transform: none !important;
  }

  @media (max-width: 1180px) {
    .site-header .site-nav-group > summary {
      width: 100%;
      min-height: 52px;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,.15);
      color: #fff;
      font-weight: 700;
      padding: 0 18px;
    }

    .site-header .site-nav-group > summary::after { border-color: #8cb2e1; }
    .site-header .site-subnav,
    .site-header .site-nav-group-wide .site-subnav {
      position: static;
      width: auto;
      min-width: 0;
      grid-template-columns: 1fr;
      gap: 0;
      border: 0;
      border-radius: 0;
      background: #153754;
      box-shadow: none;
      padding: 7px 18px 12px;
    }

    .site-header .site-subnav-hub { padding: 10px 0; }
    .site-header .site-subnav-hub + .site-subnav-hub { border-top: 1px solid rgba(255,255,255,.16); }
    .site-header .site-nav .site-subnav-title { color: #fff !important; padding: 2px 0 7px !important; }
    .site-header .site-nav .site-subnav-title b { color: #8cb2e1; }
    .site-header .site-subnav li a { color: #dceaff !important; padding: 5px 0 !important; }
    .site-header .site-subnav a:hover,
    .site-header .site-subnav a:focus-visible { color: #fff !important; }
  }
</style>
