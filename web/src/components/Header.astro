---
import settings from "../data/settings.json";

interface Props {
  mainId?: string;
}

const { mainId = "main-content" } = Astro.props;

const brand = settings.brand;
const homeHref = "https://stadttaubenhilfe-bernau.de/";
type NavLink = { label: string; href: string };
type NavGroup = { label: string; href?: string; links?: NavLink[] };

// The menu is deliberately a small set of entrance doors. Detailed topics live
// on the overview pages instead of turning the header into a site map.
const navGroups: NavGroup[] = [
  {
    label: "Taube gefunden?",
    links: [
      { label: "Erste Hilfe", href: "/fundtiere" },
      { label: "Fundtier melden", href: "/kontakt#kontaktformular" },
    ]
  },
  {
    label: "Stadttauben verstehen",
    links: [
      { label: "Warum Stadttauben unsere Hilfe brauchen", href: "/wissen" },
      { label: "Taube gleich Taube?", href: "/taube-gleich-taube" },
      { label: "Mythen & Fakten", href: "/wissen/mythen" },
      { label: "Betreuen statt vertreiben", href: "/stadttaubenmanagement" },
      { label: "Bildung & Downloads", href: "/materialien" }
    ]
  },
  {
    label: "Unsere Arbeit",
    links: [
      { label: "Überblick", href: "/projekte" },
      { label: "Taubenhaus im Fahrradparkhaus", href: "/projekte/taubenhaus" },
      { label: "Fundtierhilfe & Pflege", href: "/projekte/notfaelle" },
      { label: "Volieren", href: "/projekte/volieren" },
      { label: "Beratung für Gebäude", href: "/projekte/beratung" },
      { label: "Bildung & Aufklärung", href: "/bildung" }
    ]
  },
  {
    label: "Verein",
    links: [
      { label: "Wer wir sind", href: "/verein" },
      { label: "Vorstand & Transparenz", href: "/verein#vorstand" },
      { label: "Mitglied werden", href: "/verein#mitglied-werden" }
    ]
  },
  { label: "Mitmachen", href: "/mitmachen" },
  { label: "Aktuelles", href: "/galerie" }
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
  const cleanHref = href.split("#")[0] || "/";
  return currentPath === cleanHref || (currentPath === "/taubenhaus" && cleanHref === "/projekte");
};
const isGroupActive = (links: NavLink[] = []) => links.some((link) => isActive(link.href));
---

<a class="skip-link" href={`#${mainId}`}>Zum Inhalt springen</a>
<div class="emergency-strip">
  <div class="container">
    <strong><span aria-hidden="true">△</span> Taube in Not?</strong>
    <span>Schnell handeln, Leben retten.</span>
    <a href="/fundtiere">Erste Hilfe ansehen →</a>
  </div>
</div>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label="Startseite Stadttaubenhilfe Bernau">
      <span class="brand-mark" aria-hidden="true">
        <img class="brand-logo" src="/images/logo-stadttaubenhilfe-restored-v2.png" alt="" />
      </span>
      <span>
        <strong>{brand.name}</strong>
        <small>Bernau b. Berlin</small>
      </span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Navigation öffnen"
      aria-expanded="false"
      data-menu-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-nav" aria-label="Hauptnavigation" data-site-nav>
      {navGroups.map((group) => group.links?.length ? (
        <details class="site-nav-group">
          <summary aria-current={isGroupActive(group.links) ? "page" : undefined}>{group.label}</summary>
          <ul class="site-subnav">
            {group.links.map((link) => (
              <li><a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>{link.label}</a></li>
            ))}
          </ul>
        </details>
      ) : (
        <a href={group.href} aria-current={isActive(group.href) ? "page" : undefined}>{group.label}</a>
      ))}
      <a class="site-nav-donate" href="/spenden" aria-current={isActive("/spenden") ? "page" : undefined}>Spendenmöglichkeit anfragen <span aria-hidden="true">♥</span></a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const nav = document.querySelector("[data-site-nav]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    nav?.classList.toggle("is-open", !isOpen);
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.setAttribute("aria-expanded", "false");
      nav.classList.remove("is-open");
    });
  });

  nav?.querySelectorAll("details").forEach((group) => {
    group.addEventListener("toggle", () => {
      if (!group.open) return;
      nav.querySelectorAll("details").forEach((other) => {
        if (other !== group) other.removeAttribute("open");
      });
    });
  });
</script>

<style is:global>
  .site-header { position: sticky; top: 0; z-index: 40; }
  .site-header .site-nav-group { position: relative; }

  .site-header .site-nav-group > summary {
    display: inline-flex;
    min-height: 43px;
    align-items: center;
    border-radius: 0;
    color: #fff;
    cursor: pointer;
    font-size: .86rem;
    font-weight: 400;
    list-style: none;
    padding: 10px 0;
    white-space: nowrap;
  }

  .site-header .site-nav-group > summary::-webkit-details-marker { display: none; }
  .site-header .site-nav-group > summary:focus { outline: 0; }
  .site-header .site-nav-group > summary:focus-visible {
    outline: 0;
    box-shadow: inset 0 -2px #8cb2e1;
  }
  .site-header .site-nav-group > summary::after {
    width: auto;
    height: auto;
    margin: -2px 0 0 8px;
    border: 0;
    color: #8cb2e1;
    content: "⌄";
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1;
    transform: none;
    transition: color 180ms ease;
  }
  .site-header .site-nav-group[open] > summary::after { content: "⌃"; transform: none; }
  .site-header .site-nav-group > summary:hover,
  .site-header .site-nav-group > summary[aria-current="page"] {
    background: transparent;
    color: #fff;
    box-shadow: inset 0 -2px #8cb2e1;
    transform: none;
  }

  .site-header .site-subnav {
    position: absolute;
    z-index: 30;
    top: calc(100% + 8px);
    right: 0;
    display: grid;
    min-width: 245px;
    gap: 2px;
    border: 1px solid #c9dced;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 14px rgba(13, 41, 66, .16);
    margin: 0;
    padding: 8px;
    list-style: none;
  }

  .site-header .site-subnav li { margin: 0; }
  .site-header .site-subnav li a {
    display: block !important;
    min-height: 38px !important;
    color: #315673 !important;
    font-family: "Bricolage Grotesque", sans-serif;
    font-size: .89rem !important;
    font-weight: 600 !important;
    line-height: 1.22;
    padding: 9px 10px !important;
    white-space: normal;
  }

  .site-header .site-subnav li a[aria-current="page"] { color: #0d2942 !important; background: #eaf3fc; }

  .site-header .site-subnav a:hover,
  .site-header .site-subnav a:focus-visible {
    box-shadow: none !important;
    color: #0d2942 !important;
    text-decoration: underline;
    text-decoration-color: #f2675c;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transform: none !important;
  }

  /* The full label of the donation CTA needs a little more room than the
     desktop navigation at narrower laptop widths. Switch to the same
     touch-friendly menu before either line can start to crowd. */
  @media (max-width: 1250px) {
    .site-header .menu-toggle {
      display: grid !important;
      width: 46px;
      height: 46px;
      place-content: center;
      gap: 5px;
      border: 1px solid rgba(255,255,255,.42) !important;
      border-radius: 0 !important;
      background: transparent !important;
      color: #fff !important;
      box-shadow: none !important;
    }
    .site-header .menu-toggle span { width: 20px; height: 2px; background: #fff !important; }
    .site-header .site-nav {
      position: absolute !important;
      top: 100%;
      right: 16px;
      left: 16px;
      display: none !important;
      width: auto !important;
      margin: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: #0d2942 !important;
      box-shadow: 0 8px 12px rgba(0,0,0,.22) !important;
      padding: 0 !important;
    }
    .site-header .site-nav.is-open { display: grid !important; }
    .site-header .site-nav > a {
      width: 100% !important;
      min-height: 52px !important;
      border-bottom: 1px solid rgba(255,255,255,.15);
      color: #fff !important;
      font-weight: 700 !important;
      padding: 0 18px !important;
    }
    .site-header .site-nav .site-nav-donate {
      height: auto;
      border-radius: 0 !important;
      background: transparent !important;
      color: #fff !important;
      white-space: normal;
    }
    .site-header .site-nav .site-nav-donate span { margin-left: auto; color: #8cb2e1 !important; }

    .site-header .site-nav-group > summary {
      width: 100%;
      min-height: 52px;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,.15);
      color: #fff;
      font-weight: 700;
      padding: 0 18px;
    }

    .site-header .site-nav-group > summary::after { color: #8cb2e1; }
    .site-header .site-subnav {
      position: static;
      width: auto;
      min-width: 0;
      gap: 0;
      border: 0;
      border-radius: 0;
      background: #153754;
      box-shadow: none;
      padding: 7px 18px 12px;
    }

    .site-header .site-subnav li + li { border-top: 1px solid rgba(255,255,255,.16); }
    .site-header .site-subnav li a { color: #dceaff !important; padding: 11px 0 !important; }
    .site-header .site-subnav li a[aria-current="page"] { background: transparent; color: #fff !important; }
    .site-header .site-subnav a:hover,
    .site-header .site-subnav a:focus-visible { color: #fff !important; }
  }
</style>