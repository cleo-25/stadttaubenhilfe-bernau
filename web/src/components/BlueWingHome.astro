---
import home from "../data/blue-wing-home.json";
const { brand, emergency, nav, hero, trustItems, belief, work, impact, story, helpWays, donation, footer } = home;
---
<a class="skip" href="#main">Zum Inhalt springen</a>
<div class="site">
  <div class="emergency"><div class="shell"><strong>{emergency.label}</strong><span>{emergency.notice}</span><a href={emergency.href}>{emergency.linkLabel}</a></div></div>
  <header><div class="shell header-inner"><a class="brand" href="/"><img src={brand.logo} alt="" /><span>{brand.name}<em>{brand.location}</em></span></a><nav aria-label="Hauptnavigation">{nav.map((item) => <a href={item.href}>{item.label}</a>)}</nav><a class="button donate" href={donation.href}>Jetzt helfen →</a><details class="mobile-menu"><summary aria-label="Menü öffnen"><i></i><i></i><i></i></summary><nav aria-label="Mobile Hauptnavigation">{nav.map((item) => <a href={item.href}>{item.label}</a>)}<a href="/fundtiere">Taube gefunden?</a><a href={donation.href}>Spenden</a><a href={footer.contactHref}>Kontakt</a></nav></details></div></header>
  <main id="main">
    <section class="hero"><div class="shell hero-grid"><div class="hero-copy"><p class="overline">{hero.overline}</p><h1>{hero.title}</h1><p class="lead">{hero.text}</p><div class="actions"><a class="button urgent" href={hero.primary.href}>{hero.primary.label}</a><a class="button dark" href={hero.secondary.href}>{hero.secondary.label}</a></div></div><figure><img src={hero.image} alt={hero.imageAlt} loading="eager" decoding="async" /><figcaption>{hero.caption}</figcaption></figure></div></section>
    <section class="trust shell">{trustItems.map((item) => <span>{item}</span>)}</section>
    <section class="belief"><div class="shell two"><div><p class="overline">{belief.overline}</p><h2>{belief.title}</h2></div><div><p>{belief.text}</p><a href={belief.href}>{belief.linkLabel}</a></div></div></section>
    <section class="work shell"><p class="overline">{work.overline}</p><h2>{work.title}</h2><div class="work-grid"><figure><img src={work.image} alt={work.imageAlt} loading="lazy" decoding="async" /></figure><div><h3>{work.heading}</h3><p>{work.text}</p><ul>{work.items.map((item) => <li>{item}</li>)}</ul><a class="button dark" href={work.href}>{work.linkLabel}</a></div></div></section>
    <section class="impact"><div class="shell two"><div><p class="overline light">{impact.overline}</p><h2>{impact.title}</h2><p>{impact.text}</p></div><div class="todos">{impact.items.map((item) => <div><span>{item.label}</span><strong>{item.title}</strong><p>{item.text}</p></div>)}</div></div></section>
    <section class="story shell two"><div><p class="overline">{story.overline}</p><h2>{story.title}</h2><p>{story.text}</p><a class="button dark" href={story.href}>{story.linkLabel}</a></div><figure><img src={story.image} alt={story.imageAlt} loading="lazy" decoding="async" /></figure></section>
    <section class="ways"><div class="shell ways-grid"><div><p class="overline">{helpWays.overline}</p><h2>{helpWays.title}</h2></div>{helpWays.items.map((item) => <a href={item.href}><span>{item.label}</span><h3>{item.title}</h3><p>{item.text}</p><b>{item.linkLabel}</b></a>)}</div></section>
    <section class="giving"><div class="shell two"><div><p class="overline">{donation.overline}</p><h2>{donation.title}</h2><p>{donation.text}</p></div><div class="giving-panel"><div class="tabs"><button type="button">Einmalig</button><button type="button">Monatlich</button></div><div class="amounts"><button type="button">10 €</button><button type="button">20 €</button><button type="button">35 €</button><button type="button">Freier Betrag</button></div><p>{donation.notice}</p><a class="button donate" href={donation.href}>{donation.linkLabel}</a></div></div></section>
  </main>
  <footer><div class="shell footer"><div><img src={brand.logo} alt="" /><strong>{brand.name} {brand.location}</strong><p>{footer.text}</p></div><nav><a href="/projekte">Unsere Arbeit</a><a href="/fundtiere">Taube gefunden?</a><a href="/wissen">Taubenwissen</a><a href={donation.href}>Spenden</a></nav><div><strong>{footer.contactHeading}</strong><p>{footer.contactText}</p><a href={footer.contactHref}>{footer.contactLabel}</a></div><div class="social"><strong>{footer.socialHeading}</strong><a href={footer.facebookUrl} target="_blank" rel="noopener noreferrer">{footer.facebookLabel} <span aria-hidden="true">↗</span></a><a href={footer.instagramUrl} target="_blank" rel="noopener noreferrer">{footer.instagramLabel} <span aria-hidden="true">↗</span></a></div></div></footer>
</div>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,600;12..96,75..100,700&family=Source+Sans+3:wght@400;600;700&display=swap');
.site{--blue:#8cb2e1;--dark:#183a5a;--deep:#0d2942;--pale:#eaf3fc;--coral:#f2675c;font-family:'Source Sans 3',sans-serif;color:var(--dark);background:#f7f8fa}.shell{width:min(1180px,calc(100% - 48px));margin:auto}a{text-decoration:none;color:inherit}.skip{position:fixed;z-index:99;top:12px;left:12px;transform:translateY(-160%);padding:10px 14px;background:var(--deep);color:#fff}.skip:focus{transform:translateY(0)}.emergency{background:var(--coral);color:#fff;font-weight:700}.emergency .shell{min-height:42px;display:flex;gap:14px;align-items:center}.emergency a{margin-left:auto}header{position:sticky;top:0;z-index:10;background:#fff;border-bottom:1px solid #d8dee5}.header-inner{height:82px;display:flex;align-items:center;gap:28px}.brand{display:flex;align-items:center;gap:10px;font-family:'Bricolage Grotesque',sans-serif;font-weight:700;line-height:1.02}.brand img{width:58px;height:58px;object-fit:contain}.brand em{display:block;font-style:normal;font-family:'Source Sans 3',sans-serif;font-weight:600;font-size:.78rem}.header-inner>nav{display:flex;gap:25px;margin-left:auto;font-weight:600}.button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 18px;border-radius:10px;font-weight:700}.donate,.dark{background:var(--dark);color:#fff}.urgent{background:var(--coral);color:#fff}.hero{background:var(--blue);padding:clamp(42px,6vw,90px) 0}.hero-grid,.two{display:grid;grid-template-columns:1fr 1fr;align-items:stretch}.hero-copy{padding:clamp(20px,4vw,65px) clamp(20px,5vw,80px) clamp(20px,4vw,60px) 0}.overline{margin:0 0 14px;font-size:.96rem;font-weight:700}.hero h1,h2,h3{font-family:'Bricolage Grotesque',sans-serif;letter-spacing:-.032em;text-wrap:balance}.hero h1{max-width:8ch;margin:0;font-size:clamp(3.1rem,6vw,5.75rem);line-height:.96}.lead{font-size:1.25rem;line-height:1.45;max-width:32rem;margin:28px 0}.actions{display:flex;gap:12px;flex-wrap:wrap}.hero figure{min-height:515px;margin:0;overflow:hidden;border-radius:14px 0 0 14px}.hero img,.work img,.story img{width:100%;height:100%;object-fit:cover}.trust{display:flex;justify-content:space-between;padding:28px 0;font-weight:700}.trust span+span{border-left:1px solid #d8dee5;padding-left:4vw}.belief{padding:96px 0;background:#fff}.belief .two{gap:8vw;align-items:end}.belief h2,.work h2,.impact h2,.story h2,.ways h2,.giving h2{margin:0;font-size:clamp(2.35rem,4vw,4.2rem);line-height:1.02}.belief .two>div:last-child{font-size:1.18rem;line-height:1.55}.work{padding:100px 0}.work-grid{display:grid;grid-template-columns:1.2fr .8fr;background:var(--pale);margin-top:38px}.work figure{margin:0;min-height:480px}.work-grid>div{padding:clamp(28px,4vw,62px);align-self:center}.work h3{font-size:2.15rem;line-height:1.05;margin:0 0 15px}.work p,.story p,.giving p{font-size:1.12rem;line-height:1.55}.work ul{padding:0;margin:24px 0;list-style:none;font-weight:600}.work li{padding:9px 0;border-bottom:1px solid #b8d0ea}.work li:before{content:'✓';color:#397b68;margin-right:10px}.impact{padding:90px 0;background:var(--deep);color:#fff}.impact .two{gap:8vw}.impact .light{color:var(--blue)}.impact h2{color:#fff}.impact p{line-height:1.55}.todos{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid rgba(255,255,255,.32)}.todos div{padding:24px 16px;border-right:1px solid rgba(255,255,255,.32)}.todos div:last-child{border:0}.todos span{display:block;color:var(--blue);font-size:.85rem}.todos strong{display:block;margin:34px 0 6px}.todos p{font-size:.95rem;margin:0}.story{gap:7vw;align-items:center;padding:110px 0}.story figure{margin:0;height:500px}.ways{padding:90px 0;background:#fff}.ways-grid{display:grid;grid-template-columns:1.05fr repeat(3,1fr)}.ways-grid>div{padding:24px 28px 24px 0}.ways-grid>a{min-height:300px;padding:28px;display:flex;flex-direction:column;color:var(--deep)}.ways-grid>a:nth-child(2){background:#ffe2df}.ways-grid>a:nth-child(3){background:var(--blue)}.ways-grid>a:nth-child(4){background:var(--deep);color:#fff}.ways-grid span{font-size:.85rem;font-weight:700}.ways-grid h3{font-size:1.55rem;margin:34px 0 6px}.ways-grid p{line-height:1.5}.ways-grid b{margin-top:auto}.giving{padding:96px 0;background:var(--pale)}.giving .two{gap:7vw;align-items:center}.giving-panel{padding:28px;background:#fff}.tabs,.amounts{display:flex;gap:8px}.tabs{margin-bottom:18px}.tabs button,.amounts button{border:1px solid #d8dee5;background:#fff;padding:11px 13px;font:inherit;font-weight:700}.tabs button:first-child{background:var(--deep);color:#fff}.amounts{display:grid;grid-template-columns:repeat(4,1fr)}.giving-panel .donate{width:100%}footer{background:var(--deep);color:#fff;padding:56px 0}.footer{display:grid;grid-template-columns:1.2fr .7fr .8fr;gap:5vw}.footer img{width:68px;height:68px;object-fit:contain;background:#fff;border-radius:50%;float:left;margin:0 14px 8px 0}.footer p{color:#c9d8e7;line-height:1.5}.footer nav{display:grid;gap:8px}.footer strong{font-family:'Bricolage Grotesque',sans-serif}.mobile-menu{display:none}.mobile-menu summary{list-style:none;width:44px;height:44px;display:grid;place-content:center;gap:5px;border:1px solid #d8dee5;cursor:pointer}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu i{display:block;width:18px;height:2px;background:var(--dark)}.mobile-menu nav{position:absolute;top:72px;right:16px;left:16px;display:grid!important;gap:0!important;margin:0!important;background:#fff;border:1px solid #d8dee5;box-shadow:0 12px 28px rgba(13,41,66,.16);padding:10px}.mobile-menu nav a{padding:13px 10px;border-bottom:1px solid #eaf3fc}.mobile-menu nav a:last-child{border:0}@media(max-width:900px){.header-inner>nav{display:none}.header-inner{height:72px}.mobile-menu{display:block}.hero-grid,.two,.work-grid,.story,.giving .two{grid-template-columns:1fr}.hero{padding:0}.hero figure{order:-1;min-height:320px;border-radius:0}.hero-copy{padding:48px 0}.trust{display:grid;gap:14px}.trust span+span{padding:14px 0 0;border-left:0;border-top:1px solid #d8dee5}.belief,.work,.story,.giving{padding:64px 0}.impact,.ways{padding:64px 0}.work figure{min-height:320px}.impact .two{gap:10px}.todos{margin-top:10px}.ways-grid{grid-template-columns:1fr}.ways-grid>div{padding:0 0 25px}.ways-grid>a{min-height:220px}.story figure{height:380px}.footer{grid-template-columns:1fr;gap:30px}.emergency .shell{font-size:.9rem}.emergency span{display:none}.amounts{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.shell{width:min(100% - 32px,1180px)}.brand span{font-size:.86rem}.brand img{width:48px;height:48px}.hero h1{font-size:3.1rem}.actions>a{width:100%}.todos{grid-template-columns:1fr}.todos div{border-right:0;border-bottom:1px solid rgba(255,255,255,.32)}.todos div:last-child{border-bottom:0}.story figure{height:300px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
<style>
  .hero figure { position: relative; }
  .hero figure figcaption {
    position: absolute;
    right: 14px;
    bottom: 14px;
    padding: 8px 11px;
    background: rgba(13, 41, 66, 0.9);
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .footer { grid-template-columns: 1.2fr 0.7fr 0.8fr 0.8fr; gap: 4vw; }
  .footer nav, .social { display: grid; gap: 8px; }
  .social a { color: #c9d8e7; }
  .social a span { color: var(--blue); }
  @media (max-width: 900px) { .footer { grid-template-columns: 1fr; } }
</style>
