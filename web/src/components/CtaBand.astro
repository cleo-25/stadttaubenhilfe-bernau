---
import Button from "./Button.astro";

interface Props {
  eyebrow?: string;
  title: string;
  text: string;
  href: string;
  label: string;
}

const { eyebrow = "Nächster Schritt", title, text, href, label } = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band-inner">
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <Button href={href}>{label}</Button>
  </div>
</section>
