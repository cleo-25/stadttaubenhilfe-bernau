---
interface Item {
  title: string;
  text: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="info-list">
  {items.map((item, index) => (
    <article class="info-row">
      <span class="step-number">{String(index + 1).padStart(2, "0")}</span>
      <div>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </div>
    </article>
  ))}
</div>
