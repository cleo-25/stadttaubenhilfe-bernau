---
type IconName =
  | "care"
  | "care2"
  | "info"
  | "together"
  | "alert"
  | "heart"
  | "euro"
  | "box"
  | "phone"
  | "book"
  | "home"
  | "feather"
  | "camera"
  | "hands"
  | "mail"
  | "location";

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "care" && (
    <path d="M12 4v16M4 12h16" />
  )}
  {name === "care2" && (
    <>
      <path d="M12 20S5 16.1 5 10.5A3.5 3.5 0 0 1 11.2 8L12 9l.8-1A3.5 3.5 0 0 1 19 10.5C19 16.1 12 20 12 20Z" />
      <path d="M4 19h5l1.6 1.4H15l4-3.4" />
    </>
  )}
  {name === "info" && (
    <>
      <path d="M4 5.5A3.5 3.5 0 0 1 8 5h3.5v14H8a4 4 0 0 0-4 1.2V5.5Z" />
      <path d="M20 5.5A3.5 3.5 0 0 0 16 5h-4.5v14H16a4 4 0 0 1 4 1.2V5.5Z" />
    </>
  )}
  {name === "together" && (
    <>
      <circle cx="12" cy="8" r="3" />
      <path d="M6.5 20v-1.5a5.5 5.5 0 0 1 11 0V20M4 11a2.5 2.5 0 1 0 1.5-4.6M20 11a2.5 2.5 0 1 1-1.5-4.6M3 20v-1a4 4 0 0 1 2.5-3.7M21 20v-1a4 4 0 0 0-2.5-3.7" />
    </>
  )}
  {name === "alert" && (
    <>
      <path d="m12 3 9 17H3L12 3Z" />
      <path d="M12 9v5M12 17h.01" />
    </>
  )}
  {name === "heart" && (
    <path d="M12 20S4 15.5 4 9.7A4.1 4.1 0 0 1 11.3 7L12 8.2 12.7 7A4.1 4.1 0 0 1 20 9.7C20 15.5 12 20 12 20Z" />
  )}
  {name === "euro" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M15.7 8.2A4.7 4.7 0 0 0 8.5 10M7.5 12h6M7.5 14h6M15.7 15.8A4.7 4.7 0 0 1 8.5 14" />
    </>
  )}
  {name === "box" && (
    <>
      <path d="m4 7 8-4 8 4v10l-8 4-8-4V7Z" />
      <path d="m4 7 8 4 8-4M12 11v10" />
    </>
  )}
  {name === "phone" && (
    <path d="M7 3h3l1.4 4-2.1 1.4a14.4 14.4 0 0 0 6.2 6.2l1.4-2.1 4 1.4v3c0 1.1-.9 2-2 2C10.2 19 5 13.8 5 7c0-1.1.9-2 2-2Z" />
  )}
  {name === "book" && (
    <>
      <path d="M4 5.5A3.5 3.5 0 0 1 8 5h3.5v14H8a4 4 0 0 0-4 1.2V5.5Z" />
      <path d="M20 5.5A3.5 3.5 0 0 0 16 5h-4.5v14H16a4 4 0 0 1 4 1.2V5.5Z" />
    </>
  )}
  {name === "home" && (
    <>
      <path d="m3 11 9-8 9 8v9H3v-9Z" />
      <path d="M9 20v-5h6v5" />
    </>
  )}
  {name === "feather" && (
    <>
      <path d="M20 4C10 4 4 9.4 4 17c6.6 0 12-3.2 16-13Z" />
      <path d="M4 20 14 10M8 16h4M11 13h4" />
    </>
  )}
  {name === "camera" && (
    <>
      <path d="M4 8h3l1.2-2h7.6L17 8h3v11H4V8Z" />
      <circle cx="12" cy="13" r="3.5" />
    </>
  )}
  {name === "hands" && (
    <>
      <path d="M4 13.5 8.5 11l2 1.5 2.2-1.4c.9-.6 2.1 0 2.1 1v.9l2.3-1.3c1-.6 2.2.1 2.2 1.2V16l-5.2 4H9l-5-2.5v-4Z" />
      <path d="m8.5 11 2.4-1.4c.8-.5 1.8.1 1.8 1v1.3" />
    </>
  )}
  {name === "mail" && (
    <>
      <rect x="3" y="5" width="18" height="14" rx="1" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === "location" && (
    <>
      <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
      <circle cx="12" cy="10" r="2.5" />
    </>
  )}
</svg>

<style>
  .line-icon {
    display: block;
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
</style>
