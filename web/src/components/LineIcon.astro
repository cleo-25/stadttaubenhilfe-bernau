---
type IconName = "care" | "care2" | "info" | "together" | "alert" | "heart" | "euro";

interface Props {
  name: IconName;
}

const { name } = Astro.props;
---

<svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "care" && (
    <path d="M12 4v16M4 12h16" />
  )}
  {name === "care2" && (
    <>
      <path d="M12 20S5 16.1 5 10.5A3.5 3.5 0 0 1 11.2 8L12 9l.8-1A3.5 3.5 0 0 1 19 10.5C19 16.1 12 20 12 20Z" />
      <path d="M4 19h5l1.6 1.4H15l4-3.4" />
    </>
  )}
  {name === "info" && (
    <>
      <path d="M4 5.5A3.5 3.5 0 0 1 8 5h3.5v14H8a4 4 0 0 0-4 1.2V5.5Z" />
      <path d="M20 5.5A3.5 3.5 0 0 0 16 5h-4.5v14H16a4 4 0 0 1 4 1.2V5.5Z" />
    </>
  )}
  {name === "together" && (
    <>
      <circle cx="12" cy="8" r="3" />
      <path d="M6.5 20v-1.5a5.5 5.5 0 0 1 11 0V20M4 11a2.5 2.5 0 1 0 1.5-4.6M20 11a2.5 2.5 0 1 1-1.5-4.6M3 20v-1a4 4 0 0 1 2.5-3.7M21 20v-1a4 4 0 0 0-2.5-3.7" />
    </>
  )}
  {name === "alert" && (
    <>
      <path d="m12 3 9 17H3L12 3Z" />
      <path d="M12 9v5M12 17h.01" />
    </>
  )}
  {name === "heart" && (
    <path d="M12 20S4 15.5 4 9.7A4.1 4.1 0 0 1 11.3 7L12 8.2 12.7 7A4.1 4.1 0 0 1 20 9.7C20 15.5 12 20 12 20Z" />
  )}
  {name === "euro" && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M15.7 8.2A4.7 4.7 0 0 0 8.5 10M7.5 12h6M7.5 14h6M15.7 15.8A4.7 4.7 0 0 1 8.5 14" />
    </>
  )}
</svg>

<style>
  .line-icon {
    display: block;
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }
</style>
