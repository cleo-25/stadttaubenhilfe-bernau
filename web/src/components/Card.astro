---
import LineIcon from "./LineIcon.astro";

type IconName =
  | "alert"
  | "box"
  | "phone"
  | "heart"
  | "book"
  | "home"
  | "feather"
  | "care"
  | "together"
  | "camera"
  | "hands"
  | "euro"
  | "mail"
  | "location";

interface Props {
  eyebrow?: string;
  title: string;
  href?: string;
  tone?: "default" | "accent" | "quiet" | "blue" | "green" | "violet";
  icon?: IconName;
}

const { eyebrow, title, href, tone = "default", icon } = Astro.props;
const Tag = href ? "a" : "article";
const opensNewTab = href ? /^https?:\/\//.test(href) : false;
---

<Tag
  class:list={["card", `card-${tone}`, href && "card-link"]}
  href={href}
  target={opensNewTab ? "_blank" : undefined}
  rel={opensNewTab ? "noopener noreferrer" : undefined}
>
  {icon && <LineIcon name={icon} />}
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h3>{title}</h3>
  <div class="card-body">
    <slot />
  </div>
</Tag>
