---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "default" | "small";
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "default",
  class: className = ""
} = Astro.props;

const opensNewTab = /^https?:\/\//.test(href);
---

<a
  class:list={["button", `button-${variant}`, `button-${size}`, className]}
  href={href}
  target={opensNewTab ? "_blank" : undefined}
  rel={opensNewTab ? "noopener noreferrer" : undefined}
>
  <slot />
</a>
